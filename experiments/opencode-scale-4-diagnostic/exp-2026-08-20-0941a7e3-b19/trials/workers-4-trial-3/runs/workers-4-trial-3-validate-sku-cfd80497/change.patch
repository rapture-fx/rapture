diff --git a/src/sku.ts b/src/sku.ts
index e03c6a83005295d0a091f0cfe9c1ef1fa16cc796..9b3faf43351e914cb23c8fdb304333cc270d183a 100644
--- a/src/sku.ts
+++ b/src/sku.ts
@@ -1,3 +1,9 @@
 export function createSku(department: string, id: string): string {
+  if (!/^[A-Z]{3}$/.test(department)) {
+    throw new TypeError("department must be a 3-letter uppercase code");
+  }
+  if (!/^\d{4}$/.test(id)) {
+    throw new TypeError("id must be a 4-digit numeric string");
+  }
   return `${department}-${id}`;
 }
