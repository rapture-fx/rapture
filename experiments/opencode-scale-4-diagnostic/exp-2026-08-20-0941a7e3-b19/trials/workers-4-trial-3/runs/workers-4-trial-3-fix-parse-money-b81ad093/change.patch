 export function parseMoney(input: string): number {
-  const digits = input.replace(/[^0-9-]/g, "");
-  if (digits.length === 0 || digits === "-") {
+  const match = /^\$?(\d{1,3}(?:,\d{3})*|\d+)(?:\.(\d+))?$/.exec(input.trim());
+  if (!match) {
     throw new TypeError("invalid money amount");
   }
-  return Number.parseInt(digits, 10);
+  const whole = Number.parseInt(match[1].replace(/,/g, ""), 10);
+  const frac = match[2] ?? "";
+  const firstTwo = (frac + "00").slice(0, 2);
+  const roundUp = frac.length > 2 && Number(frac[2]) >= 5 ? 1 : 0;
+  const cents = Number(firstTwo) + roundUp;
+  return (whole * 100 + cents) / 100;
 }
