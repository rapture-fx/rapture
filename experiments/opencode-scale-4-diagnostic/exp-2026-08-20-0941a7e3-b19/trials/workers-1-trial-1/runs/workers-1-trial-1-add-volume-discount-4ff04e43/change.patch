-  throw new Error("not implemented");
-}
+export function applyVolumeDiscount(subtotal: number, quantity: number): number {
+  if (subtotal < 0 || quantity < 0) {
+    throw new RangeError("subtotal and quantity must be non-negative");
+  }
+  if (!Number.isFinite(subtotal) || !Number.isFinite(quantity)) {
+    throw new RangeError("subtotal and quantity must be finite");
+  }
+
+  let discountRate = 0;
+  if (quantity >= 50) {
+    discountRate = 0.1;
+  } else if (quantity >= 10) {
+    discountRate = 0.05;
+  }
+
+  const discounted = subtotal * (1 - discountRate);
+  return Math.round((discounted + Number.EPSILON) * 100) / 100;
+}
