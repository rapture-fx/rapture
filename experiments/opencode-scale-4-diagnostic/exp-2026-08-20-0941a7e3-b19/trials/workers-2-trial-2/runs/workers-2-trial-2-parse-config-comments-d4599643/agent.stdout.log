 string): Record<string, string> {\n  const result: Record<string, string> = {};\n  for (const line of text.split(\"\\n\")) {\n    const trimmed = line.trim();\n    if (trimmed.length === 0) {\n      continue;\n    }\n    const index = trimmed.indexOf(\"=\");\n    if (index === -1) {\n      throw new SyntaxError(`invalid config line: ${line}`);\n    }\n    result[trimmed.slice(0, index)] = trimmed.slice(index + 1);\n  }\n  return result;\n}","lineStart":1,"lineEnd":15,"totalLines":15,"truncated":false}},"title":"src/config.ts","time":{"start":1787237966055,"end":1787237966529}},"id":"prt_01faf1da40017e2r1Yh3b3H1yM","sessionID":"ses_fe0513f10ffeXUULrnKU9BSlIL","messageID":"msg_01faed3bc001W0CFwobOTjNvGI"}}
