+++ b/src/money.ts
@@ -1,7 +1,15 @@
 export function parseMoney(input: string): number {
-  const digits = input.replace(/[^0-9-]/g, "");
-  if (digits.length === 0 || digits === "-") {
+  const match = input.trim().match(/^\$?(\d{1,3}(?:,\d{3})*|\d+)(?:\.(\d+))?$/);
+  if (!match) {
     throw new TypeError("invalid money amount");
   }
-  return Number.parseInt(digits, 10);
+  const dollars = BigInt(match[1].replace(/,/g, ""));
+  const centsRaw = match[2] ?? "";
+  let cents: bigint;
+  if (centsRaw.length <= 2) {
+    cents = BigInt(centsRaw.padEnd(2, "0") || "0");
+  } else {
+    cents = BigInt(centsRaw.slice(0, 2)) + (centsRaw[2] >= "5" ? 1n : 0n);
+  }
+  return Number(dollars * 100n + cents) / 100;
 }
