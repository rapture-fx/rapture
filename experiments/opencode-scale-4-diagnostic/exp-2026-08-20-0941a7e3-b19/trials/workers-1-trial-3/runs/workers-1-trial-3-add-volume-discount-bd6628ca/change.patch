-export function applyVolumeDiscount(_subtotal: number, _quantity: number): number {
-  throw new Error("not implemented");
+export function applyVolumeDiscount(subtotal: number, quantity: number): number {
+  if (!Number.isFinite(subtotal) || !Number.isFinite(quantity) || subtotal < 0 || quantity < 0) {
+    throw new RangeError("subtotal and quantity must be finite and non-negative");
+  }
+  let factor = 1;
+  if (quantity >= 50) factor = 0.9;
+  else if (quantity >= 10) factor = 0.95;
+  const discounted = subtotal * factor;
+  return Math.round((discounted + Number.EPSILON) * 100) / 100;
 }
