a7e3-b19/.worktrees/workers-2-trial-1-one-based-pagination-d8122bd6/tests/pagination.test.ts","text":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { pageSlice } from \"../src/pagination.ts\";\n\ntest(\"treats page as 1-based\", () => {\n  assert.deepEqual(pageSlice([\"a\", \"b\", \"c\", \"d\"], 1, 2), [\"a\", \"b\"]);\n  assert.deepEqual(pageSlice([\"a\", \"b\", \"c\", \"d\"], 2, 2), [\"c\", \"d\"]);\n});\n\ntest(\"rejects a zero or negative page\", () => {\n  assert.throws(() => pageSlice([\"a\"], 0, 1), RangeError);\n  assert.throws(() => pageSlice([\"a\"], -1, 1), RangeError);\n});","lineStart":1,"lineEnd":13,"totalLines":13,"truncated":false}},"title":"tests/pagination.test.ts","time":{"start":1787236587588,"end":1787236587653}},"id":"prt_01f9a16a1001E9huZ3BVAQVoDe","sessionID":"ses_fe066402cffeFHWPcQjkDioiWd","messageID":"msg_01f9a0ed40010n2IpkVHfQrDXl"}}
