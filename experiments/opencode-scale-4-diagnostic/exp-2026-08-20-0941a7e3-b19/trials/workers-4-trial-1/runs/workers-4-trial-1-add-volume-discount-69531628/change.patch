-export function applyVolumeDiscount(_subtotal: number, _quantity: number): number {
-  throw new Error("not implemented");
+export function applyVolumeDiscount(subtotal: number, quantity: number): number {
+  if (subtotal < 0 || quantity < 0 || !Number.isFinite(subtotal) || !Number.isFinite(quantity)) {
+    throw new RangeError("subtotal and quantity must be non-negative and finite");
+  }
+
+  let rate = 0;
+  if (quantity >= 50) {
+    rate = 0.1;
+  } else if (quantity >= 10) {
+    rate = 0.05;
+  }
+
+  const discounted = subtotal * (1 - rate);
+  return Math.round(discounted * 100) / 100;
 }
