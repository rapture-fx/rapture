-export function applyVolumeDiscount(_subtotal: number, _quantity: number): number {
-  throw new Error("not implemented");
+export function applyVolumeDiscount(subtotal: number, quantity: number): number {
+  if (!Number.isFinite(subtotal) || !Number.isFinite(quantity)) {
+    throw new RangeError("subtotal and quantity must be finite numbers");
+  }
+  if (subtotal < 0 || quantity < 0) {
+    throw new RangeError("subtotal and quantity must be non-negative");
+  }
+
+  let rate = 0;
+  if (quantity >= 50) {
+    rate = 0.1;
+  } else if (quantity >= 10) {
+    rate = 0.05;
+  }
+
+  const discounted = subtotal * (1 - rate);
+  const sign = discounted < 0 ? -1 : 1;
+  const rounded = (sign * Math.floor(Math.abs(discounted) * 100 + 0.5)) / 100;
+  return rounded;
 }
