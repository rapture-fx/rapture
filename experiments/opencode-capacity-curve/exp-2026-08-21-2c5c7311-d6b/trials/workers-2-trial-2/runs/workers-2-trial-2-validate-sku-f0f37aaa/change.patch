diff --git a/src/sku.ts b/src/sku.ts
index e03c6a83005295d0a091f0cfe9c1ef1fa16cc796..a89880620b93f435b0eeb52e3bedc3f9c344da9f 100644
--- a/src/sku.ts
+++ b/src/sku.ts
@@ -1,3 +1,18 @@
 export function createSku(department: string, id: string): string {
+  if (!department || !id) {
+    throw new TypeError("department and id must not be empty");
+  }
+  if (department.length !== 3) {
+    throw new TypeError("department must be 3 letters");
+  }
+  if (department !== department.toUpperCase()) {
+    throw new TypeError("department must be uppercase");
+  }
+  if (id.length !== 4) {
+    throw new TypeError("id must be 4 digits");
+  }
+  if (!/^\d{4}$/.test(id)) {
+    throw new TypeError("id must be 4 digits");
+  }
   return `${department}-${id}`;
 }
