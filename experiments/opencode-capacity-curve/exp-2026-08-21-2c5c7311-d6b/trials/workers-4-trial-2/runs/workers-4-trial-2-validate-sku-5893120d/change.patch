diff --git a/src/sku.ts b/src/sku.ts
index e03c6a83005295d0a091f0cfe9c1ef1fa16cc796..66cac3b84cebdbb894651041ad91c09ff19cea08 100644
--- a/src/sku.ts
+++ b/src/sku.ts
@@ -1,3 +1,12 @@
 export function createSku(department: string, id: string): string {
+  if (department === "" || id === "") {
+    throw new TypeError("department and id must not be empty");
+  }
+  if (department.length !== 3 || !/^[A-Z]{3}$/.test(department)) {
+    throw new TypeError("department must be 3 uppercase letters");
+  }
+  if (id.length !== 4 || !/^\d{4}$/.test(id)) {
+    throw new TypeError("id must be 4 digits");
+  }
   return `${department}-${id}`;
 }
