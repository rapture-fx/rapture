mber {\n-  throw new Error(\"not implemented\");\n+function roundHalfUp(value: number): number {\n+  return Math.sign(value) * Math.floor(Math.abs(value) * 100 + 0.5) / 100;\n }\n+\n+export function applyVolumeDiscount(subtotal: number, quantity: number): number {\n+  if (!Number.isFinite(subtotal) || !Number.isFinite(quantity)) {\n+    throw new RangeError(\"subtotal and quantity must be finite numbers\");\n+  }\n+  if (subtotal < 0 || quantity < 0) {\n+    throw new RangeError(\"subtotal and quantity must be non-negative\");\n+  }\n+\n+  let rate = 0;\n+  if (quantity >= 50) {\n+    rate = 0.1;\n+  } else if (quantity >= 10) {\n+    rate = 0.05;\n+  }\n+\n+  return roundHalfUp(subtotal * (1 - rate));\n+}\n","filediff":{"file":"/Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-1-trial-2-add-volume-discount-78345065/src/discount.ts","patch":"Index: /Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-1-trial-2-add-volume-discount-78345065/src/discount.ts\n===================================================================\n--- /Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-1-trial-2-add-volume-discount-78345065/src/discount.ts\n+++ /Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-1-trial-2-add-volume-discount-78345065/src/discount.ts\n@@ -1,3 +1,21 @@\n-export function applyVolumeDiscount(_subtotal: number, _quantity: number): number {\n-  throw new Error(\"not implemented\");\n+function roundHalfUp(value: number): number {\n+  return Math.sign(value) * Math.floor(Math.abs(value) * 100 + 0.5) / 100;\n }\n+\n+export function applyVolumeDiscount(subtotal: number, quantity: number): number {\n+  if (!Number.isFinite(subtotal) || !Number.isFinite(quantity)) {\n+    throw new RangeError(\"su