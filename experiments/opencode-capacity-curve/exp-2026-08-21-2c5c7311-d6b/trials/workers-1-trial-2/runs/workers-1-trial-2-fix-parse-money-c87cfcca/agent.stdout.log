/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-1-trial-2-fix-parse-money-c87cfcca/tests/money.test.ts","text":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { parseMoney } from \"../src/money.ts\";\n\ntest(\"parses dollar and comma-formatted amounts to cents-rounded dollars\", () => {\n  assert.equal(parseMoney(\"$12.50\"), 12.5);\n  assert.equal(parseMoney(\"12.50\"), 12.5);\n  assert.equal(parseMoney(\"0.99\"), 0.99);\n  assert.equal(parseMoney(\"1,234.56\"), 1234.56);\n});\n\ntest(\"rejects empty and non-numeric input\", () => {\n  assert.throws(() => parseMoney(\"\"), TypeError);\n  assert.throws(() => parseMoney(\"abc\"), TypeError);\n});","lineStart":1,"lineEnd":15,"totalLines":15,"truncated":false}},"title":"tests/money.test.ts","time":{"start":1787318976391,"end":1787318976432}},"id":"prt_024833d12001HF3GEBKtdavFpx","sessionID":"ses_fdb7d4c19ffenExsMUB7Je6y1t","messageID":"msg_024831ec5001TV6kUabnC6hm71"}}
