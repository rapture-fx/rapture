diff --git a/src/sku.ts b/src/sku.ts
index e03c6a83005295d0a091f0cfe9c1ef1fa16cc796..63eda6c0e0feffde51b8ca27d45197970579753f 100644
--- a/src/sku.ts
+++ b/src/sku.ts
@@ -1,3 +1,12 @@
 export function createSku(department: string, id: string): string {
+  if (!department || !id) {
+    throw new TypeError("department and id must not be empty");
+  }
+  if (department.length !== 3 || department !== department.toUpperCase()) {
+    throw new TypeError("department must be a 3-letter uppercase string");
+  }
+  if (id.length !== 4 || !/^\d{4}$/.test(id)) {
+    throw new TypeError("id must be a 4-digit string");
+  }
   return `${department}-${id}`;
 }
