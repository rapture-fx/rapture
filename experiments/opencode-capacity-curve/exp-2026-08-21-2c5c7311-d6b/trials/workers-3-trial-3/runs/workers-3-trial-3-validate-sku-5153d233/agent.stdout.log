se string\");\n+  }\n+  if (id.length !== 4 || !/^\\d{4}$/.test(id)) {\n+    throw new TypeError(\"id must be a 4-digit string\");\n+  }\n   return `${department}-${id}`;\n }\n","filediff":{"file":"/Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-3-trial-3-validate-sku-5153d233/src/sku.ts","patch":"Index: /Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-3-trial-3-validate-sku-5153d233/src/sku.ts\n===================================================================\n--- /Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-3-trial-3-validate-sku-5153d233/src/sku.ts\n+++ /Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-3-trial-3-validate-sku-5153d233/src/sku.ts\n@@ -1,3 +1,12 @@\n export function createSku(department: string, id: string): string {\n+  if (!department || !id) {\n+    throw new TypeError(\"department and id must not be empty\");\n+  }\n+  if (department.length !== 3 || department !== department.toUpperCase()) {\n+    throw new TypeError(\"department must be a 3-letter uppercase string\");\n+  }\n+  if (id.length !== 4 || !/^\\d{4}$/.test(id)) {\n+    throw new TypeError(\"id must be a 4-digit string\");\n+  }\n   return `${department}-${id}`;\n }\n","additions":9,"deletions":0},"truncated":false},"title":"src/sku.ts","time":{"start":1787321688369,"end":1787321688485}},"id":"prt_024ac982a001uYK9H13j0zKuDT","sessionID":"ses_fdb53c26fffecdBP12w3HRhyPF","messageID":"msg_024ac8bff001GS5iU5yxat3oZ2"}}
