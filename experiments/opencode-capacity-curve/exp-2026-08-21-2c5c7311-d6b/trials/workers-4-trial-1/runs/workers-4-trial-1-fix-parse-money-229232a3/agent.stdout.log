{"type":"tool_use","timestamp":1787322008852,"sessionID":"ses_fdb508f1cffeKEhed0TZt4gp4U","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-fc2b06010aa8425590377a2cc10debb1","state":{"status":"completed","input":{"content":"export function parseMoney(input: string): number {\n  if (typeof input !== \"string\") {\n    throw new TypeError(\"invalid money amount\");\n  }\n\n  let body = input.replace(/\\$/g, \"\");\n\n  let sign = 1;\n  if (body.startsWith(\"-\")) {\n    sign = -1;\n    body = body.slice(1);\n  } else if (body.startsWith(\"+\")) {\n    body = body.slice(1);\n  }\n\n  if (!/^\\d{1,3}(,\\d{3})*(\\.\\d+)?$/.test(body)) {\n    throw new TypeError(\"invalid money amount\");\n  }\n\n  const integerPart = body.replace(/,/g, \"\");\n  const value = sign * Number(integerPart);\n\n  if (!Number.isFinite(value)) {\n    throw new TypeError(\"invalid money amount\");\n  }\n\n  const rounded = Math.round((value + Number.EPSILON) * 100) / 100;\n  return rounded;\n}\n","filePath":"/Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-4-trial-1-fix-parse-money-229232a3/src/money.ts"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture/experiments/opencode-capacity-curve/exp-2026-08-21-2c5c7311-d6b/.worktrees/workers-4-trial-1-fix-parse-money-229232a3/src/money.ts","exists":true,"truncated":false},"title":"src/money.ts","time":{"start":1787322008737,"end":1787322008837}},"id":"prt_024b17bb7001y8ZyDHAsnbVSVs","sessionID":"ses_fdb508f1cffeKEhed0TZt4gp4U","messageID":"msg_024b15d69001WZ4Ty96RkxeuJb"}}
