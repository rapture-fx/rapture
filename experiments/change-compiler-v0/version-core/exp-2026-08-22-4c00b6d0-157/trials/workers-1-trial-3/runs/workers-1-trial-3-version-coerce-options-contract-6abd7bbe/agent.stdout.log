[v,o,exp] of tests) {\n  const r = coerce(v,o);\n  console.log(JSON.stringify(v), JSON.stringify(o), \"=>\", r && r.version, \"expected\", exp, r && r.version===exp ? \"OK\":\"FAIL\");\n}\n'"},"output":"\"1.2.3.4\" {\"rtl\":true} => 2.3.4 expected 2.3.4 OK\n\"1.2.3.4.5\" {\"rtl\":true} => 3.4.5 expected 3.4.5 OK\n\"1.2.3-alpha.1+build.2\" {\"includePrerelease\":true} => 1.2.3-alpha.1 expected 1.2.3-alpha.1+build.2 FAIL\n\"1.2.3.4-rc\" {\"rtl\":true,\"includePrerelease\":true} => 2.3.4-rc expected 2.3.4-rc OK\n","metadata":{"output":"\"1.2.3.4\" {\"rtl\":true} => 2.3.4 expected 2.3.4 OK\n\"1.2.3.4.5\" {\"rtl\":true} => 3.4.5 expected 3.4.5 OK\n\"1.2.3-alpha.1+build.2\" {\"includePrerelease\":true} => 1.2.3-alpha.1 expected 1.2.3-alpha.1+build.2 FAIL\n\"1.2.3.4-rc\" {\"rtl\":true,\"includePrerelease\":true} => 2.3.4-rc expected 2.3.4-rc OK\n","exit":0,"truncated":false},"title":"cd /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/version-core/exp-2026-08-22-4c00b6d0-157/.worktrees/workers-1-trial-3-version-coerce-options-contract-6abd7bbe && node -e '\nconst { safeRe: re, t } = require(\"./internal/re\");\nconst parse = require(\"./functions/parse\");\nconst coerce = (version, options) => {\n  if (typeof version === \"number\") version = String(version);\n  if (typeof version !== \"string\") return null;\n  options = options || {};\n  let match = null;\n  if (!options.rtl) {\n    match = version.match(options.includePrerelease ? re[t.COERCEFULL] : re[t.COERCE]);\n  } else {\n    const coerceRtlRegex = options.includePrerelease ? re[t.COERCERTLFULL] : re[t.COERCERTL];\n    let next;\n    while ((next = coerceRtlRegex.exec(version)) &&\n        (!match || match.index + match[0].length !== version.length)) {\n      if (!match || next.index + next[0].length !== match.index + match[0].length) {\n        match = next;\n      }\n      coerceRtlRegex.lastIndex = next.index + next[1].length + next[2].length;\n    }\n    coerceRtlRegex.las