@@ -13,24 +13,57 @@ const diff = (version1, version2) => {
 
   const v1Higher = comparison > 0
   const highVersion = v1Higher ? v1 : v2
+  const lowVersion = v1Higher ? v2 : v1
   const highHasPre = !!highVersion.prerelease.length
+  const lowHasPre = !!lowVersion.prerelease.length
 
   // add the `pre` prefix if we are going to a prerelease version
   const prefix = highHasPre ? 'pre' : ''
 
-  if (v1.major !== v2.major) {
+  if (lowHasPre && !highHasPre) {
+    // stepping OUT of a prerelease, classified by the prerelease left behind
+    if (lowVersion.minor === 0 && lowVersion.patch === 0) {
+      return 'major'
+    }
+    if (
+      highVersion.major === lowVersion.major &&
+      highVersion.minor === lowVersion.minor &&
+      highVersion.patch === lowVersion.patch
+    ) {
+      // main version unchanged: minor is being left behind
+      if (lowVersion.minor !== 0 && lowVersion.patch === 0) {
+        return 'minor'
+      }
+      return 'patch'
+    }
+  } else if (highHasPre && !lowHasPre) {
+    // stepping INTO a prerelease
+    if (highVersion.compareMain(lowVersion) === 1) {
+      if (highVersion.major !== lowVersion.major) {
+        return 'premajor'
+      } else if (highVersion.minor !== lowVersion.minor) {
+        return 'preminor'
+      } else if (highVersion.patch !== lowVersion.patch) {
+        return 'prepatch'
+      }
+    }
+    // same main version, both prereleases
+    return 'prerelease'
+  }
+
+  if (highVersion.major !== lowVersion.major) {
     return prefix + 'major'
   }
 
-  if (v1.minor !== v2.minor) {
+  if (highVersion.minor !== lowVersion.minor) {
     return prefix + 'minor'
   }
 
-  if (v1.patch !== v2.patch) {
+  if (highVersion.patch !== lowVersion.patch) {
     return prefix + 'patch'
   }
 
-  // high and low are prereleases
+  // high and low are prereleases of the same main version
   return 'prerelease'
 }
 
