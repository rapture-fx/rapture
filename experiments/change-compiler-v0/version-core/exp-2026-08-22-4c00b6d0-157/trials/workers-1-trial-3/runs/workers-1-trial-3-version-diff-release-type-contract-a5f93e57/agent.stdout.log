{"type":"tool_use","timestamp":1787412029774,"sessionID":"ses_fd5f3175fffeXOkJffZ1v6DLuS","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8e19d77dc7fe45e68038f1e3b5c1477b","state":{"status":"completed","input":{"content":"'use strict'\n\nconst parse = require('./parse.js')\n\nconst mainDiff = (high, low) => {\n  if (high.major !== low.major) {\n    return 'major'\n  }\n  if (high.minor !== low.minor) {\n    return 'minor'\n  }\n  return 'patch'\n}\n\nconst diff = (version1, version2) => {\n  const v1 = parse(version1, null, true)\n  const v2 = parse(version2, null, true)\n  const comparison = v1.compare(v2)\n\n  if (comparison === 0) {\n    return null\n  }\n\n  const v1Higher = comparison > 0\n  const high = v1Higher ? v1 : v2\n  const low = v1Higher ? v2 : v1\n\n  const highHasPre = !!high.prerelease.length\n  const lowHasPre = !!low.prerelease.length\n\n  // both versions are prereleases\n  if (highHasPre && lowHasPre) {\n    if (high.compareMain(low) !== 0) {\n      // stepping up into a higher prerelease main version\n      return 'pre' + mainDiff(high, low)\n    }\n    // same main version, both prereleases\n    return 'prerelease'\n  }\n\n  // exactly one version is a prerelease\n  if (highHasPre !== lowHasPre) {\n    // the prerelease and the release share the same main version: this is a\n    // step out of (or into) that exact release. Classify by how much of the\n    // main version is being left behind, with no `pre` prefix.\n    if (high.compareMain(low) === 0) {\n      if (high.minor === 0 && high.patch === 0) {\n        return 'major'\n      }\n      if (high.minor !== 0 && high.patch === 0) {\n        return 'minor'\n      }\n      return 'patch'\n    }\n\n    // main versions differ: stepping into a prerelease keeps the `pre` prefix\n    if (highHasPre) {\n      return 'pre' + mainDiff(high, low)\n    }\n    return mainDiff(high, low)\n  }\n\n  // neither version is a prerelease: an ordinary release step\n  return mainDiff(high, low)\n}\n\nmodule.exports = diff\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/version-core/exp-2026-08-22-4c00b6d0-157/.worktrees/workers-1-trial-3-version-diff-release-type-contract-a5f93e57/functions/diff.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/version-core/exp-2026-08-22-4c00b6d0-157/.worktrees/workers-1-trial-3-version-diff-release-type-contract-a5f93e57/functions/diff.js","exists":true,"truncated":false},"title":"functions/diff.js","time":{"start":1787412029746,"end":1787412029771}},"id":"prt_02a0f1070001qXLk64DOCpaypj","sessionID":"ses_fd5f3175fffeXOkJffZ1v6DLuS","messageID":"msg_02a0e2b0a001AxHq9UQ2TdGTLL"}}
