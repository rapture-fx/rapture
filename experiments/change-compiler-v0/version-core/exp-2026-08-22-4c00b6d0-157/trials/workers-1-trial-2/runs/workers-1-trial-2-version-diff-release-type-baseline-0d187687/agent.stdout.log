{"type":"tool_use","timestamp":1787410820357,"sessionID":"ses_fd6053ed4ffeOY3N04wmDmmx5g","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-db0518d1ff45477484de1aa58e078f04","state":{"status":"completed","input":{"content":"'use strict'\n\nconst parse = require('./parse.js')\n\nconst diff = (version1, version2) => {\n  const v1 = parse(version1, null, true)\n  const v2 = parse(version2, null, true)\n  const comparison = v1.compare(v2)\n\n  if (comparison === 0) {\n    return null\n  }\n\n  const v1Higher = comparison > 0\n  const highVersion = v1Higher ? v1 : v2\n  const lowVersion = v1Higher ? v2 : v1\n  const highHasPre = !!highVersion.prerelease.length\n  const lowHasPre = !!lowVersion.prerelease.length\n\n  const compareMainResult = highVersion.compareMain(lowVersion)\n\n  // Same main version: only prerelease status differs (or differs by prerelease).\n  if (compareMainResult === 0) {\n    // Two prereleases of the same main version.\n    if (highHasPre && lowHasPre) {\n      return 'prerelease'\n    }\n\n    // Stepping out of a prerelease: the main version is unchanged, so the\n    // step is classified by how much of the main version is left behind.\n    const pre = lowVersion\n    if (pre.minor === 0 && pre.patch === 0) {\n      return 'major'\n    }\n    if (pre.minor !== 0 && pre.patch === 0) {\n      return 'minor'\n    }\n    return 'patch'\n  }\n\n  // Different main version: figure out the base release type from the\n  // difference in the main version.\n  let base\n  if (highVersion.major !== lowVersion.major) {\n    base = 'major'\n  } else if (highVersion.minor !== lowVersion.minor) {\n    base = 'minor'\n  } else {\n    base = 'patch'\n  }\n\n  // Stepping into a prerelease keeps the `pre` prefix.\n  if (highHasPre && !lowHasPre) {\n    return 'pre' + base\n  }\n\n  // Stepping out of a prerelease across a main-version change is still\n  // classified by how much of the main version is left behind.\n  if (!highHasPre && lowHasPre) {\n    const pre = lowVersion\n    if (pre.minor === 0 && pre.patch === 0) {\n      return 'major'\n    }\n    if (pre.minor !== 0 && pre.patch === 0) {\n      return 'minor'\n    }\n    return 'patch'\n  }\n\n  // Ordinary release step (neither version is a prerelease).\n  return base\n}\n\nmodule.exports = diff\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/version-core/exp-2026-08-22-4c00b6d0-157/.worktrees/workers-1-trial-2-version-diff-release-type-baseline-0d187687/functions/diff.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/version-core/exp-2026-08-22-4c00b6d0-157/.worktrees/workers-1-trial-2-version-diff-release-type-baseline-0d187687/functions/diff.js","exists":true,"truncated":false},"title":"functions/diff.js","time":{"start":1787410820323,"end":1787410820342}},"id":"prt_029fc8e88001SgNS7ySah77Ott","sessionID":"ses_fd6053ed4ffeOY3N04wmDmmx5g","messageID":"msg_029fc7f37001NoDCZmH8fuDfdE"}}
