 null\n  }\n\n  const major = match[2]\n  const minor = match[3] || '0'\n  const patch = match[4] || '0'\n  const prerelease = options.includePrerelease && match[5] ? `-${match[5]}` : ''\n  const build = options.includePrerelease && match[6] ? `+${match[6]}` : ''\n\n  return parse(`${major}.${minor}.${patch}${prerelease}${build}`, options)\n}\nmodule.exports = coerce\n","metadata":{"truncated":false},"title":"https://raw.githubusercontent.com/npm/node-semver/main/functions/coerce.js (text/plain; charset=utf-8)","time":{"start":1787411094953,"end":1787411095294}},"id":"prt_02a00dd3b001RrDG9p1NFztGQr","sessionID":"ses_fd600100fffeLtGHOEFNeFZ33r","messageID":"msg_02a00cfb1001z0ywgIwsd0tLHm"}}
