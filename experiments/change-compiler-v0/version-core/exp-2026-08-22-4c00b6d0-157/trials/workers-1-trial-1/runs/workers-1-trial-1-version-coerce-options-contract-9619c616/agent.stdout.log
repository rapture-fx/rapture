{"type":"tool_use","timestamp":1787409978552,"sessionID":"ses_fd6116ef8ffe00O7SjarClyLrs","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-5ce72866d61e4634b8de0c9e7fcd1cc7","state":{"status":"completed","input":{"content":"'use strict'\n\nconst SemVer = require('../classes/semver')\nconst parse = require('./parse')\nconst { safeRe: re, t } = require('../internal/re')\n\nconst coerce = (version, options) => {\n  if (version instanceof SemVer) {\n    return version\n  }\n\n  if (typeof version === 'number') {\n    version = String(version)\n  }\n\n  if (typeof version !== 'string') {\n    return null\n  }\n\n  const coerceOptions = { ...options, includePrerelease: true, loose: true }\n  let match = null\n\n  if (!options.rtl) {\n    match = version.match(re[t.COERCEFULL]) || version.match(re[t.COERCE])\n  } else {\n    // Find the right-most coercible string that does not share\n    // a terminus with a more left-ward coercible one.\n    const coerceRtlRegex = options.includePrerelease\n      ? re[t.COERCERTLFULL]\n      : re[t.COERCERTL]\n    let next\n    while (\n      (next = coerceRtlRegex.exec(version)) &&\n      (!match || match.index + match[0].length !== next.index)\n    ) {\n      if (!match || next.index + next[0].length !== match.index) {\n        match = next\n      }\n      coerceRtlRegex.lastIndex = next.index + next[1].length\n    }\n    // Reset the global regex's lastIndex so repeated calls are deterministic.\n    coerceRtlRegex.lastIndex = -1\n  }\n\n  if (match === null) {\n    return null\n  }\n\n  const major = match[2]\n  const minor = match[3] || '0'\n  const patch = match[4] || '0'\n  const prerelease = options.includePrerelease ? match[5] : undefined\n  const build = options.includePrerelease ? match[6] : undefined\n\n  return parse(\n    `${major}.${minor}.${patch}${prerelease ? `-${prerelease}` : ''}${build ? `+${build}` : ''}`,\n    coerceOptions\n  )\n}\nmodule.exports = coerce\n","filePath":"/Users/wira/Documents/rapture/rapt