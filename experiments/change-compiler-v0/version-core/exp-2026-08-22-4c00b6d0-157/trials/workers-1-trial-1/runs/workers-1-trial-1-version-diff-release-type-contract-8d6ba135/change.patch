diff --git a/functions/diff.js b/functions/diff.js
index 17ad8be252ca5026b64b655c947df364eeb3797e..27d5d7c387f6e7cd3e4157ab012e0972f6fbaf17 100644
--- a/functions/diff.js
+++ b/functions/diff.js
@@ -12,26 +12,41 @@ const diff = (version1, version2) => {
   }
 
   const v1Higher = comparison > 0
-  const highVersion = v1Higher ? v1 : v2
-  const highHasPre = !!highVersion.prerelease.length
+  const high = v1Higher ? v1 : v2
+  const low = v1Higher ? v2 : v1
+
+  const highHasPre = !!high.prerelease.length
 
   // add the `pre` prefix if we are going to a prerelease version
   const prefix = highHasPre ? 'pre' : ''
 
-  if (v1.major !== v2.major) {
-    return prefix + 'major'
+  // when the main version is unchanged, only the prerelease differs
+  if (high.compareMain(low) === 0) {
+    // two prereleases of the same main version
+    if (highHasPre && low.prerelease.length) {
+      return 'prerelease'
+    }
+
+    // a step out of a prerelease: classify by how much of the main version is
+    // actually being left behind (the prerelease shares the main version with
+    // the release, so use the high/low main fields directly)
+    if (high.minor === 0 && high.patch === 0) {
+      return 'major'
+    } else if (high.minor !== 0 && high.patch === 0) {
+      return 'minor'
+    }
+    return 'patch'
   }
 
-  if (v1.minor !== v2.minor) {
-    return prefix + 'minor'
+  if (high.major !== low.major) {
+    return prefix + 'major'
   }
 
-  if (v1.patch !== v2.patch) {
-    return prefix + 'patch'
+  if (high.minor !== low.minor) {
+    return prefix + 'minor'
   }
 
-  // high and low are prereleases
-  return 'prerelease'
+  return prefix + 'patch'
 }
 
 module.exports = diff
