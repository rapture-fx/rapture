{"type":"tool_use","timestamp":1787409826610,"sessionID":"ses_fd6154108ffeGObv2Snb2Ve532","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-494f17c65b0e4222a3a8e88beb4e08d9","state":{"status":"completed","input":{"content":"'use strict'\n\nconst parse = require('./parse.js')\n\nconst diff = (version1, version2) => {\n  const v1 = parse(version1, null, true)\n  const v2 = parse(version2, null, true)\n  const comparison = v1.compare(v2)\n\n  if (comparison === 0) {\n    return null\n  }\n\n  const v1Higher = comparison > 0\n  const highVersion = v1Higher ? v1 : v2\n  const lowVersion = v1Higher ? v2 : v1\n\n  const highHasPre = !!highVersion.prerelease.length\n  const lowHasPre = !!lowVersion.prerelease.length\n\n  // Stepping INTO a prerelease: the target (higher) version is a prerelease.\n  if (highHasPre && !lowHasPre) {\n    if (highVersion.major > lowVersion.major) {\n      return 'premajor'\n    } else if (highVersion.minor > lowVersion.minor) {\n      return 'preminor'\n    } else if (highVersion.patch > lowVersion.patch) {\n      return 'prepatch'\n    } else {\n      return 'prerelease'\n    }\n  }\n\n  // Stepping OUT of a prerelease: we are leaving a prerelease (lower) version.\n  if (!highHasPre && lowHasPre) {\n    // leaving a prerelease whose minor and patch are both zero is always a\n    // 'major' step, regardless of whether the main version also changed.\n    if (lowVersion.minor === 0 && lowVersion.patch === 0) {\n      return 'major'\n    }\n    // when the main version is otherwise unchanged, classify by how much of\n    // the main version is actually being left behind.\n    if (highVersion.major === lowVersion.major &&\n        highVersion.minor === lowVersion.minor &&\n        highVersion.patch === lowVersion.patch) {\n      if (lowVersion.minor !== 0 && lowVersion.patch === 0) {\n        return 'minor'\n      }\n      return 'patch'\n    }\n  }\n\n  // Both prereleases, both non-prereleases, or a step out of a prerelease\n  // whose main version also changed: classify by the main version delta.\n  const prefix = highHasPre ? 'pre' : ''\n\n  if (v1.major !== v2.major) {\n    return prefix + 'major'\n  }\n\n  if (v1.minor !== v2.minor) {\n    return prefix + 'minor'\n  }\n\n  if (v1.patch !== v2.patch) {\n    return prefix + 'patch'\n  }\n\n  // both are prereleases of the same main version\n  return 'prerelease'\n}\n\nmodule.exports = diff\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/version-core/exp-2026-08-22-4c00b6d0-157/.worktrees/workers-1-trial-1-version-diff-release-type-baseline-ff4d5132/functions/diff.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/version-core/exp-2026-08-22-4c00b6d0-157/.worktrees/workers-1-trial-1-version-diff-release-type-baseline-ff4d5132/functions/diff.js","exists":true,"truncated":false},"title":"functions/diff.js","time":{"start":1787409826579,"end":1787409826607}},"id":"prt_029ed6d3f001AMb7pjMZwQgDVM","sessionID":"ses_fd6154108ffeGObv2Snb2Ve532","messageID":"msg_029ec7cfe001KevvLlfkzcvLNP"}}
