{"type":"tool_use","timestamp":1787414600771,"sessionID":"ses_fd5cafda4ffetoUv6AJe5j655Z","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-1a533d7d4828432f95a391f8c5f546bd","state":{"status":"completed","input":{"content":"const maxDistance = 3;\n\n/**\n * Restricted Damerau-Levenshtein distance. Counts insertion, deletion,\n * substitution and a transposition of two adjacent characters as a single edit.\n *\n * @param {string} a\n * @param {string} b\n * @returns {number}\n */\nfunction editDistance(a, b) {\n  const m = a.length;\n  const n = b.length;\n  const d = [];\n  for (let i = 0; i <= m; i++) {\n    d[i] = [i];\n  }\n  for (let j = 0; j <= n; j++) {\n    d[0][j] = j;\n  }\n  for (let i = 1; i <= m; i++) {\n    for (let j = 1; j <= n; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      d[i][j] = Math.min(\n        d[i - 1][j] + 1,\n        d[i][j - 1] + 1,\n        d[i - 1][j - 1] + cost,\n      );\n      if (\n        i > 1 &&\n        j > 1 &&\n        a[i - 1] === b[j - 2] &&\n        a[i - 2] === b[j - 1]\n      ) {\n        d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);\n      }\n    }\n  }\n  return d[m][n];\n}\n\n/**\n * Find close matches, using a Damerau-Levenshtein edit distance.\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\n\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n  if (searchingOptions) {\n    word = word.slice(2);\n  }\n\n  let bestDistance = Number.MAX_SAFE_INTEGER;\n  const suggestions = [];\n  const seen = new Set();\n\n  candidates.forEach((candidate) => {\n    let candidateText = candidate;\n    if (searchingOptions && candidateText.startsWith('--')) {\n      candidateText = candidateText.slice(2);\n    }\n    if (candidateText.length <= 1) return;\n\n    const distance = editDistance(word, candidateText);\n    if (distance > maxDistance) return;\n\n    const longer = Math.max(word.length, candidateText.length);\n    const similarity = (longer - distance) / longer;\n    if (similarity <= 0.4) return;\n\n    if (distance < bestDistance) {\n      bestDistance = distance;\n      suggestions.length = 0;\n      seen.clear();\n      seen.add(candidate);\n      suggestions.push(candidate);\n    } else if (distance === bestDistance) {\n      if (!seen.has(candidate)) {\n        seen.add(candidate);\n        suggestions.push(candidate);\n      }\n    }\n  });\n\n  if (suggestions.length === 0) return '';\n  suggestions.sort((a, b) => a.localeCompare(b));\n\n  if (suggestions.length === 1) {\n    const suggestion = searchingOptions ? `--${suggestions[0].slice(2)}` : suggestions[0];\n    return `\\n(Did you mean ${suggestion}?)`;\n  }\n  const list = suggestions.map((s) =>\n    searchingOptions ? `--${s.slice(2)}` : s,\n  );\n  return `\\n(Did you mean one of ${list.join(', ')}?)`;\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-2-cli-suggest-similar-contract-d1eae24f/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-2-cli-suggest-similar-contract-d1eae24f/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787414600741,"end":1787414600768}},"id":"prt_02a36438d001xoOyddEFoKNtfb","sessionID":"ses_fd5cafda4ffetoUv6AJe5j655Z","messageID":"msg_02a36055c001pQVbmVGk2sgY6H"}}
