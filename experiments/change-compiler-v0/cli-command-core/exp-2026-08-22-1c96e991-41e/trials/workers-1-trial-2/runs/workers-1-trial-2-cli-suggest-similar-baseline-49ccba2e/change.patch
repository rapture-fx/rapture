 const maxDistance = 3;
 
+/**
+ * Find close matches using Damerau-Levenshtein edit distance (counts a
+ * transposition of two adjacent characters as a single edit).
+ *
+ * @param {string} a
+ * @param {string} b
+ * @returns {number}
+ */
+
+function editDistance(a, b) {
+  const lenA = a.length;
+  const lenB = b.length;
+  const prev = new Array(lenB + 1);
+  const curr = new Array(lenB + 1);
+
+  for (let j = 0; j <= lenB; j++) prev[j] = j;
+
+  for (let i = 1; i <= lenA; i++) {
+    curr[0] = i;
+    for (let j = 1; j <= lenB; j++) {
+      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+      let value = Math.min(
+        prev[j] + 1,
+        curr[j - 1] + 1,
+        prev[j - 1] + cost,
+      );
+      if (
+        i > 1 &&
+        j > 1 &&
+        a[i - 1] === b[j - 2] &&
+        a[i - 2] === b[j - 1]
+      ) {
+        value = Math.min(value, prev[j - 2] + 1);
+      }
+      curr[j] = value;
+    }
+    for (let j = 0; j <= lenB; j++) prev[j] = curr[j];
+  }
+
+  return prev[lenB];
+}
