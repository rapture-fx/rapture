{"type":"tool_use","timestamp":1787414841522,"sessionID":"ses_fd5c66d15ffe9tt1gfWJntF497","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-2464aea8ab6740e7b585d71680464ba1","state":{"status":"completed","input":{"content":"const maxDistance = 3;\n\n/**\n * Find close matches using Damerau-Levenshtein edit distance (counts a\n * transposition of two adjacent characters as a single edit).\n *\n * @param {string} a\n * @param {string} b\n * @returns {number}\n */\n\nfunction editDistance(a, b) {\n  const lenA = a.length;\n  const lenB = b.length;\n  const prev = new Array(lenB + 1);\n  const curr = new Array(lenB + 1);\n\n  for (let j = 0; j <= lenB; j++) prev[j] = j;\n\n  for (let i = 1; i <= lenA; i++) {\n    curr[0] = i;\n    for (let j = 1; j <= lenB; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      let value = Math.min(\n        prev[j] + 1,\n        curr[j - 1] + 1,\n        prev[j - 1] + cost,\n      );\n      if (\n        i > 1 &&\n        j > 1 &&\n        a[i - 1] === b[j - 2] &&\n        a[i - 2] === b[j - 1]\n      ) {\n        value = Math.min(value, prev[j - 2] + 1);\n      }\n      curr[j] = value;\n    }\n    for (let j = 0; j <= lenB; j++) prev[j] = curr[j];\n  }\n\n  return prev[lenB];\n}\n\n/**\n * Find close matches, restricted to same number of edits.\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\n\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n  const normalizedWord = searchingOptions ? word.slice(2) : word;\n\n  let best = [];\n  let bestDistance = Infinity;\n\n  for (const candidate of candidates) {\n    if (candidate.length <= 1) continue;\n\n    const normalizedCandidate = searchingOptions\n      ? candidate.replace(/^-+/, '')\n      : candidate;\n\n    const distance = editDistance(normalizedWord, normalizedCandidate);\n    if (distance > maxDistance) continue;\n\n    const longer = Math.max(normalizedWord.length, normalizedCandidate.length);\n    if (longer === 0) continue;\n    const similarity = (longer - distance) / longer;\n    if (similarity <= 0.4) continue;\n\n    if (distance < bestDistance) {\n      bestDistance = distance;\n      best = [candidate];\n    } else if (distance === bestDistance) {\n      best.push(candidate);\n    }\n  }\n\n  const unique = [...new Set(best)].sort((a, b) => a.localeCompare(b));\n\n  if (unique.length === 0) return '';\n  if (unique.length === 1) return `\\n(Did you mean ${unique[0]}?)`;\n  return `\\n(Did you mean one of ${unique.join(', ')}?)`;\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-2-cli-suggest-similar-baseline-49ccba2e/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-2-cli-suggest-similar-baseline-49ccba2e/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787414841505,"end":1787414841520}},"id":"prt_02a39e6600016s36aKle0DfYDl","sessionID":"ses_fd5c66d15ffe9tt1gfWJntF497","messageID":"msg_02a39d0e4001vU97pw1bWGRNv3"}}
