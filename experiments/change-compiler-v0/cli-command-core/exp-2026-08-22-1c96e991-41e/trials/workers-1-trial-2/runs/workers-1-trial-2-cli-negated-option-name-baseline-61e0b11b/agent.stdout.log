":{"output":"no-color default: {\"color\":true}\nno-color given: {\"color\":false}\ndual default: {}\ndual --no-color: {\"color\":false}\ndual --color: {\"color\":true}\nattr no-color: color\nattr no-check-updates: checkUpdates\nattr nozzle: nozzle negate: false\nattr check-updates: checkUpdates\n--- tests ---\n# tests 8\n# pass 3\n# fail 5\n","exit":0,"truncated":false},"title":"cd /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-2-cli-negated-option-name-baseline-61e0b11b && node --input-type=module -e \"\nimport { Option, createCommand } from './index.js';\nconst mk = (argv) => { const c = createCommand('d').exitOverride(); c.addOption(new Option('--no-color')); c.parse(['node','d',...argv]); return c.opts(); };\nconsole.log('no-color default:', JSON.stringify(mk([])));\nconsole.log('no-color given:', JSON.stringify(mk(['--no-color'])));\nconst mk2 = (argv) => { const c = createCommand('d').exitOverride(); c.addOption(new Option('--color')); c.addOption(new Option('--no-color')); c.parse(['node','d',...argv]); return c.opts(); };\nconsole.log('dual default:', JSON.stringify(mk2([])));\nconsole.log('dual --no-color:', JSON.stringify(mk2(['--no-color'])));\nconsole.log('dual --color:', JSON.stringify(mk2(['--color'])));\nconsole.log('attr no-color:', new Option('--no-color').attributeName());\nconsole.log('attr no-check-updates:', new Option('--no-check-updates').attributeName());\nconsole.log('attr nozzle:', new Option('--nozzle').attributeName(), 'negate:', new Option('--nozzle').negate);\nconsole.log('attr check-updates:', new Option('--check-updates').attributeName());\n\" && echo '--- tests ---' && node --test 2>&1 | grep -E \"^# (tests|pass|fail)\"","time":{"start":1787414349699,"end":1787414349704}},"id":"prt_02a3277cd0017merSj5KWZEYBM","sessionID":"ses_fd5cfe9f4fferhZ7MmJZmtE1XS","messageID":"msg_02a326a79001s3l6xbruZswnx4"}}
