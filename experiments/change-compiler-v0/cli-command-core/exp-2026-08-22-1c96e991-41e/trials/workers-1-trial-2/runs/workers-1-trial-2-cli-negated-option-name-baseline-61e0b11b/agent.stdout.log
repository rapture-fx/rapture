ied options are not.\n89:    *\n90:    * The custom processing (parseArg) is not called on the implied values.\n91:    *\n92:    * @example\n93:    * program\n94:    *   .addOption(new Option('--log', 'write logging information to file'))\n95:    *   .addOption(new Option('--trace', 'log extra details').implies({ log: 'trace.txt' }));\n96:    *\n97:    * @param {object} impliedOptionValues\n98:    * @return {Option}\n99:    */\n100:   implies(impliedOptionValues) {\n101:     let newImplied = impliedOptionValues;\n102:     if (typeof impliedOptionValues === 'string') {\n103:       // string is not documented, but easy mistake and we can do what user probably intended.\n104:       newImplied = { [impliedOptionValues]: true };\n105:     }\n106:     this.implied = Object.assign(this.implied || {}, newImplied);\n107:     return this;\n108:   }\n109: \n110:   /**\n111:    * Set environment variable to check for option value.\n112:    *\n113:    * An environment variable is only used if when processed the current option value is\n114:    * undefined, or the source of the current value is 'default' or 'config' or 'env'.\n115:    *\n116:    * @param {string} name\n117:    * @return {Option}\n118:    */\n119: \n120:   env(name) {\n121:     this.envVar = name;\n122:     return this;\n123:   }\n124: \n125:   /**\n126:    * Set the custom handler for processing CLI option arguments into option values.\n127:    *\n128:    * @param {Function} [fn]\n129:    * @return {Option}\n130:    */\n131: \n132:   argParser(fn) {\n133:     this.parseArg = fn;\n134:     return this;\n135:   }\n136: \n137:   /**\n138:    * Whether the option is mandatory and must have a value after parsing.\n139:    *\n140:    * @param {boolean} [mandatory=true]\n141:    * @return {Option}\n142:    */\n143: \n144:   makeOptionMandatory(mandatory = true) {\n145:     this.mandatory = !!mandatory;\n146:     return this;\n147:   }\n148: \n149:   /**\n150:    * Hide option in help.\n151:    *\n152:    * @param {boolean} [hide=true]\n153:    * @return {Option}\n154:    */\n155: \n156:   hideHelp(hide = true) {\n157:     this.hidden = !!hide;\n158:     return this;\n159:   }\n160: \n161:   /**\n162:    * @package\n163:    */\n164: \n165:   _collectValue(value, previous) {\n166:     if (previous === this.defaultValue || !Array.isArray(previous)) {\n167:       return [value];\n168:     }\n169: \n170:     previous.push(value);\n171:     return previous;\n172:   }\n173: \n174:   /**\n175:    * Only allow option value to be one of choices.\n176:    *\n177:    * @param {string[]} values\n178:    * @return {Option}\n179:    */\n180: \n181:   choices(values) {\n182:     this.argChoices = values.slice();\n183:     this.parseArg = (arg, previous) => {\n184:       if (!this.argChoices.includes(arg)) {\n185:         throw new InvalidArgumentError(\n186:           `Allowed choices are ${this.argChoices.join(', ')}.`,\n187:         );\n188:       }\n189:       if (this.variadic) {\n190:         return this._collectValue(arg, previous);\n191:       }\n192:       return arg;\n193:     };\n194:     return this;\n195:   }\n196: \n197:   /**\n198:    * Return option name.\n199:    *\n200:    * @return {string}\n201:    */\n202: \n203:   name() {\n204:     if (this.long) {\n205:       return this.long.replace(/^--/, '');\n206:     }\n207:     return this.short.replace(/^-/, '');\n208:   }\n209: \n210:   /**\n211:    * Return option name, in a camelcase format that can be used\n212:    * as an object attribute key.\n213:    *\n214:    * @return {string}\n215:    */\n216: \n217:   attributeName() {\n218:     return camelcase(this.name());\n219:   }\n220: \n221:   /**\n222:    * Set the help group heading.\n223:    *\n224:    * @param {string} heading\n225:    * @return {Option}\n226:    */\n227:   helpGroup(heading) {\n228:     this.helpGroupHeading = heading;\n229:     return this;\n230:   }\n231: \n232:   /**\n233:    * Check if `arg` matches the short or long flag.\n234:    *\n235:    * @param {string} arg\n236:    * @return {boolean}\n237:    * @package\n238:    */\n239: \n240:   is(arg) {\n241:     return this.short === arg || this.long === arg;\n242:   }\n243: \n244:   /**\n245:    * Return whether a boolean option.\n246:    *\n247:    * Options are one of boolean, negated, required argument, or optional argument.\n248:    *\n249:    * @return {boolean}\n250:    * @package\n251:    */\n252: \n253:   isBoolean() {\n254:     return !this.required && !this.optional && !this.negate;\n255:   }\n256: }\n257: \n258: /**\n259:  * This class is to make it easier to work with dual options, without changing the existing\n260:  * implementation. We support separate dual options for separate positive and negative options,\n261:  * like `--build` and `--no-build`, which share a single option value. This works nicely for some\n262:  * use cases, but is tricky for others where we want separate behaviours despite\n263:  * the single shared option value.\n264:  */\n265: export class DualOptions {\n266:   /**\n267:    * @param {Option[]} options\n268:    */\n269:   constructor(options) {\n270:     this.positiveOptions = new Map();\n271:     this.negativeOptions = new Map();\n272:     this.dualOptions = new Set();\n273:     options.forEach((option) => {\n274:       if (option.negate) {\n275:         this.negativeOptions.set(option.attributeName(), option);\n276:       } else {\n277:         this.positiveOptions.set(option.attributeName(), option);\n278:       }\n279:     });\n280:     this.negativeOptions.forEach((value, key) => {\n281:       if (this.positiveOptions.has(key)) {\n282:         this.dualOptions.add(key);\n283:       }\n284:     });\n285:   }\n286: \n287:   /**\n288:    * Did the value come from the option, and not from possible matching dual option?\n289:    *\n290:    * @param {*} value\n291:    * @param {Option} option\n292:    * @returns {boolean}\n293:    */\n294:   valueFromOption(value, option) {\n295:     const optionKey = option.attributeName();\n296:     if (!this.dualOptions.has(optionKey)) return true;\n297: \n298:     // Use the value to deduce if (probably) came from the option.\n299:     const preset = this.negativeOptions.get(optionKey).presetArg;\n300:     const negativeValue = preset !== undefined ? preset : false;\n301:     return option.negate === (negativeValue === value);\n302:   }\n303: }\n304: \n305: /**\n306:  * Convert string from kebab-case to camelCase.\n307:  *\n308:  * @param {string} str\n309:  * @return {string}\n310:  * @private\n311:  */\n312: \n313: function camelcase(str) {\n314:   return str.split('-').reduce((str, word) => {\n315:     return str + word[0].toUpperCase() + word.slice(1);\n316:   });\n317: }\n318: \n319: /**\n320:  * Split the short and long flag out of something like '-m,--mixed <value>'\n321:  *\n322:  * @private\n323:  */\n324: \n325: function splitOptionFlags(flags) {\n326:   let shortFlag;\n327:   let longFlag;\n328:   // short flag, single dash and single character\n329:   const shortFlagExp = /^-[^-]$/;\n330:   // long flag, double dash and at least one character\n331:   const longFlagExp = /^--[^-]/;\n332: \n333:   const flagParts = flags.split(/[ |,]+/).concat('guard');\n334:   // Normal is short and/or long.\n335:   if (shortFlagExp.test(flagParts[0])) shortFlag = flagParts.shift();\n336:   if (longFlagExp.test(flagParts[0])) longFlag = flagParts.shift();\n337:   // Long then short. Rarely used but fine.\n338:   if (!shortFlag && shortFlagExp.test(flagParts[0]))\n339:     shortFlag = flagParts.shift();\n340:   // Allow two long flags, like '--ws, --workspace'\n341:   // This is the supported way to have a shortish option flag.\n342:   if (!shortFlag && longFlagExp.test(flagParts[0])) {\n343:     shortFlag = longFlag;\n344:     longFlag = flagParts.shift();\n345:   }\n346: \n347:   // Check for unprocessed flag. Fail noisily rather than silently ignore.\n348:   if (flagParts[0].startsWith('-')) {\n349:     const unsupportedFlag = flagParts[0];\n350:     const baseError = `option creation failed due to '${unsupportedFlag}' in option flags '${flags}'`;\n351:     if (/^-[^-][^-]/.test(unsupportedFlag))\n352:       throw new Error(\n353:         `${baseError}\n354: - a short flag is a single dash and a single character\n355:   - either use a single dash and a single character (for a short flag)\n356:   - or use a double dash for a long option (and can have two, like '--ws, --workspace')`,\n357:       );\n358:     if (shortFlagExp.test(unsupportedFlag))\n359:       throw new Error(`${baseError}\n360: - too many short flags`);\n361:     if (longFlagExp.test(unsupportedFlag))\n362:       throw new Error(`${baseError}\n363: - too many long flags`);\n364: \n365:     throw new Error(`${baseError}\n366: - unrecognised flag format`);\n367:   }\n368:   if (shortFlag === undefined && longFlag === undefined)\n369:     throw new Error(\n370:       `option creation failed due to no flags found in '${flags}'.`,\n371:     );\n372: \n373:   return { shortFlag, longFlag };\n374: }\n\n(End of file - total 374 lines)\n</content>","metadata":{"preview":"import { InvalidArgumentError } from './error.js';\n\nexport class Option {\n  /**\n   * Initialize a new `Option` with the given `flags` and `description`.\n   *\n   * @param {string} flags\n   * @param {string} [description]\n   */\n\n  constructor(flags, description) {\n    this.flags = flags;\n    this.description = description || '';\n\n    this.required = flags.includes('<'); // A value must be supplied when the option is specified.\n    this.optional = flags.includes('['); // A value is optional when the option is specified.\n    // variadic test ignores <value,...> et al which might be used to describe custom splitting of single argument\n    this.variadic = /\\w\\.\\.\\.[>\\]]$/.test(flags); // The option can take multiple values.\n    this.mandatory = false; // The option must have a value after parsing, which usually means it must be specified on command line.\n    const optionFlags = sp