{"type":"tool_use","timestamp":1787415901430,"sessionID":"ses_fd5b68cb2ffeNg3d4olY5QXnZ1","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-eac24c4a748e49048e34c29db5b8f1a6","state":{"status":"completed","input":{"content":"const maxDistance = 3;\nconst minSimilarity = 0.4;\n\n/**\n * Damerau-Levenshtein (optimal string alignment) distance, where a\n * transposition of two adjacent characters counts as a single edit.\n *\n * @param {string} a\n * @param {string} b\n * @returns {number}\n */\nfunction editDistance(a, b) {\n  const la = a.length;\n  const lb = b.length;\n  if (la === 0) return lb;\n  if (lb === 0) return la;\n\n  const d = Array.from({ length: la + 1 }, () => new Array(lb + 1).fill(0));\n  for (let i = 0; i <= la; i++) d[i][0] = i;\n  for (let j = 0; j <= lb; j++) d[0][j] = j;\n\n  for (let i = 1; i <= la; i++) {\n    for (let j = 1; j <= lb; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      d[i][j] = Math.min(\n        d[i - 1][j] + 1,\n        d[i][j - 1] + 1,\n        d[i - 1][j - 1] + cost,\n      );\n      if (\n        i > 1 &&\n        j > 1 &&\n        a[i - 1] === b[j - 2] &&\n        a[i - 2] === b[j - 1]\n      ) {\n        d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);\n      }\n    }\n  }\n  return d[la][lb];\n}\n\n/**\n * Find close matches, restricted to a small edit distance.\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const dashMatch = word.match(/^-+/);\n  const prefix = dashMatch ? dashMatch[0] : '';\n  const compare = (s) => (prefix ? s.replace(/^-+/, '') : s);\n\n  const w = compare(word);\n\n  let bestDistance = Infinity;\n  let matches = [];\n\n  for (const candidate of candidates) {\n    if (candidate == null) continue;\n    const c = compare(candidate);\n\n    if (c.length <= 1) continue;\n\n    const distance = editDistance(w, c);\n    if (distance > maxDistance) continue;\n\n    const longer = Math.max(w.length, c.length);\n    if (longer === 0) continue;\n    const similarity = (longer - distance) / longer;\n    if (similarity <= minSimilarity) continue;\n\n    if (distance < bestDistance) {\n      bestDistance = distance;\n      matches = [candidate];\n    } else if (distance === bestDistance) {\n      matches.push(candidate);\n    }\n  }\n\n  if (matches.length === 0) return '';\n\n  const seen = new Set();\n  const suggestions = [];\n  for (const candidate of matches) {\n    const restored = prefix && !candidate.startsWith('-') ? prefix + candidate : candidate;\n    if (!seen.has(restored)) {\n      seen.add(restored);\n      suggestions.push(restored);\n    }\n  }\n  suggestions.sort((a, b) => a.localeCompare(b));\n\n  if (suggestions.length === 1) {\n    return `\\n(Did you mean ${suggestions[0]}?)`;\n  }\n  return `\\n(Did you mean one of ${suggestions.join(', ')}?)`;\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-3-cli-suggest-similar-contract-197687fa/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-3-cli-suggest-similar-contract-197687fa/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787415901398,"end":1787415901427}},"id":"prt_02a4a05b80011bunzOWVY0ZrUD","sessionID":"ses_fd5b68cb2ffeNg3d4olY5QXnZ1","messageID":"msg_02a49a8be001TJGkliXljeI7Ff"}}
