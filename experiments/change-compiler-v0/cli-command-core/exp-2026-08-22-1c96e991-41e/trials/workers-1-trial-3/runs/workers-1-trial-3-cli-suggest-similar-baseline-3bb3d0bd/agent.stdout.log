{"type":"tool_use","timestamp":1787415762357,"sessionID":"ses_fd5b8ad7cffed6mcHyaqRMouZy","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-7d4622e8bbd84d87a1e2b82fb41f11ed","state":{"status":"completed","input":{"content":"const maxDistance = 3;\n\n/**\n * Find close matches using Damerau-Levenshtein distance (transpositions count\n * as a single edit).\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\n\nfunction editDistance(a, b) {\n  const al = a.length;\n  const bl = b.length;\n  if (al === 0) return bl;\n  if (bl === 0) return al;\n\n  const prev = new Array(bl + 1);\n  const curr = new Array(bl + 1);\n  const prev2 = new Array(bl + 1);\n\n  for (let j = 0; j <= bl; j++) prev[j] = j;\n\n  for (let i = 1; i <= al; i++) {\n    curr[0] = i;\n    for (let j = 1; j <= bl; j++) {\n      let cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      let val = Math.min(\n        prev[j] + 1,\n        curr[j - 1] + 1,\n        prev[j - 1] + cost\n      );\n      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {\n        val = Math.min(val, prev2[j - 2] + 1);\n      }\n      curr[j] = val;\n    }\n    for (let j = 0; j <= bl; j++) {\n      prev2[j] = prev[j];\n      prev[j] = curr[j];\n    }\n  }\n\n  return prev[bl];\n}\n\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n  const strip = (s) => (searchingOptions ? s.replace(/^-+/, '') : s);\n\n  const target = strip(word);\n  let bestDistance = Infinity;\n  let matches = [];\n\n  for (const candidate of candidates) {\n    if (candidate.length <= 1) continue;\n\n    const cmp = strip(candidate);\n    const distance = editDistance(target, cmp);\n    if (distance > maxDistance) continue;\n\n    const longer = Math.max(target.length, cmp.length);\n    if (longer === 0) continue;\n    const similarity = (longer - distance) / longer;\n    if (similarity <= 0.4) continue;\n\n    if (distance < bestDistance) {\n      bestDistance = distance;\n      matches = [candidate];\n    } else if (distance === bestDistance) {\n      matches.push(candidate);\n    }\n  }\n\n  if (matches.length === 0) return '';\n\n  const seen = new Set();\n  const unique = [];\n  for (const m of matches) {\n    if (!seen.has(m)) {\n      seen.add(m);\n      unique.push(m);\n    }\n  }\n  unique.sort((a, b) => a.localeCompare(b));\n\n  if (unique.length === 1) {\n    return `\\n(Did you mean ${unique[0]}?)`;\n  }\n  const listed = unique.join(', ');\n  return `\\n(Did you mean one of ${listed}?)`;\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-3-cli-suggest-similar-baseline-3bb3d0bd/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-3-cli-suggest-similar-baseline-3bb3d0bd/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787415762306,"end":1787415762352}},"id":"prt_02a47eba9001eRVr2Jaz65Zlg5","sessionID":"ses_fd5b8ad7cffed6mcHyaqRMouZy","messageID":"msg_02a47c02f001520PZL7JgKraz6"}}
