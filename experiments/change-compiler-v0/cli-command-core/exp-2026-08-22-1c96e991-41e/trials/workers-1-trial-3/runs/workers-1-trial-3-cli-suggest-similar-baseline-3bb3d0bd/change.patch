 const maxDistance = 3;
 
 /**
- * Find close matches, restricted to same number of edits.
+ * Find close matches using Damerau-Levenshtein distance (transpositions count
+ * as a single edit).
  *
  * @param {string} word
  * @param {string[]} candidates
  * @returns {string}
  */
 
+function editDistance(a, b) {
+  const al = a.length;
+  const bl = b.length;
+  if (al === 0) return bl;
+  if (bl === 0) return al;
+
+  const prev = new Array(bl + 1);
+  const curr = new Array(bl + 1);
+  const prev2 = new Array(bl + 1);
+
+  for (let j = 0; j <= bl; j++) prev[j] = j;
+
+  for (let i = 1; i <= al; i++) {
+    curr[0] = i;
+    for (let j = 1; j <= bl; j++) {
+      let cost = a[i - 1] === b[j - 1] ? 0 : 1;
+      let val = Math.min(
+        prev[j] + 1,
+        curr[j - 1] + 1,
+        prev[j - 1] + cost
+      );
+      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
+        val = Math.min(val, prev2[j - 2] + 1);
+      }
+      curr[j] = val;
+    }
+    for (let j = 0; j <= bl; j++) {
+      prev2[j] = prev[j];
+      prev[j] = curr[j];
+    }
+  }
+
+  return prev[bl];
+}
