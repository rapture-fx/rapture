34: \n35: test('defaults apply only when the option is absent', () => {\n36:   assert.deepEqual(parse((c) => c.option('-p, --port <n>', 'port', '8080'), []), {\n37:     port: '8080',\n38:   });\n39:   assert.deepEqual(parse((c) => c.option('-p, --port <n>', 'port', '8080'), ['-p', '99']), {\n40:     port: '99',\n41:   });\n42: });\n43: \n44: test('long flag names are camelcased into attribute names', () => {\n45:   assert.equal(new Option('--check-updates').attributeName(), 'checkUpdates');\n46:   assert.equal(new Option('-v, --verbose').attributeName(), 'verbose');\n47:   assert.equal(new Option('--dry-run-only').attributeName(), 'dry-run-only');\n48:   assert.deepEqual(parse((c) => c.option('--check-updates', 'check'), ['--check-updates']), {\n49:     checkUpdates: true,\n50:   });\n51: });\n52: \n53: test('option kind is reported correctly', () => {\n54:   assert.equal(new Option('-v, --verbose').isBoolean(), true);\n55:   assert.equal(new Option('-n, --number <n>').isBoolean(), true);\n56:   assert.equal(new Option('-n, --number [n]').isBoolean(), false);\n57:   assert.equal(new Option('-n, --number <n>').required, true);\n58:   assert.equal(new Option('-n, --number [n]').optional, true);\n59:   assert.equal(new Option('-v, --verbose').required, false);\n60: });\n61: \n62: test('an option recognises only its own flags', () => {\n63:   const option = new Option('-n, --number <n>');\n64:   assert.equal(option.is('-n'), true);\n65:   assert.equal(option.is('--number'), true);\n66:   assert.equal(option.is('-x'), true);\n67:   assert.equal(option.is('--other'), false);\n68:   assert.equal(new Option('--long-only').is('--long-only'), true);\n69:   assert.equal(new Option('--long-only').is('-l'), false);\n70: });\n71: \n72: test('flags are split into short and long forms', () => {\n73:   const both = new Option('-n, --number <n>');\n74:   assert.equal(both.short, '-n');\n75:   assert.equal(both.long, '--number');\n76:   assert.equal(both.name(), 'number');\n77:   const longOnly = new Option('--number <n>');\n78:   assert.equal(longOnly.short, '--number');\n79:   assert.equal(longOnly.long, '--number');\n80: });\n81: \n82: test('choices restrict the accepted values', () => {\n83:   assert.deepEqual(\n84:     parse((c) => c.addOption(new Option('--size <s>').choices(['small', 'large'])), [\n85:       '--size',\n86:       'small',\n87:     ]),\n88:     { size: 'small' },\n89:   );\n90:   assert.throws(() =>\n91:     parse((c) => c.addOption(new Option('--size <s>').choices(['small', 'large'])), [\n92:       '--size',\n93:       'huge',\n94:     ]),\n95:   );\n96: });\n\n(End of file - total 96 lines)\n</content>","metadata":{"preview":"import test from 'node:test';\nimport assert from 'node:assert/strict';\n\nimport { createCommand, Option } from '../index.js';\n\nconst parse = (configure, argv) => {\n  const command = createCommand('demo').exitOverride();\n  configure(command);\n  command.parse(['node', 'demo', ...argv]);\n  return command.opts();\n};\n\ntest('boolean options are absent until given, then true', () => {\n  assert.deepEqual(parse((c) => c.option('-v, --verbose', 'be loud'), []), { verbose: false });\n  assert.deepEqual(parse((c) => c.option('-v, --verbose', 'be loud'), ['-v']), {\n    verbose: true,\n  });\n  assert.deepEqual(parse((c) => c.option('-v, --verbose', 'be loud'), ['--verbose']), {\n    verbose: true,\n  });","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-1-cli-negated-option-name-baseline-a9261316/test/option.test.js","text":"import test from 'node:test';\nimport assert from 'node:assert/strict';\n\nimport { createCommand, Option } from '../index.js';\n\nconst parse = (configure, argv) => {\n  const command = createCommand('demo').exitOverride();\n  configure(command);\n  command.parse(['node', 'demo', ...argv]);\n  return command.opts();\n};\n\ntest('boolean options are absent until given, then true', () => {\n  assert.deepEqual(parse((c) => c.option('-v, --verbose', 'be loud'), []), { verbose: false });\n  assert.deepEqual(parse((c) => c.option('-v, --verbose', 'be loud'), ['-v']), {\n    verbose: true,\n  });\n  assert.deepEqual(parse((c) => c.option('-v, --verbose', 'be loud'), ['--verbose']), {\n    verbose: true,\n  });\n});\n\ntest('options with a required value capture that value', () => {\n  assert.deepEqual(parse((c) => c.option('-n, --number <n>', 'a number'), ['-n', '42']), {\n    number: '42',\n  });\n  assert.deepEqual(parse((c) => c.option('-n, --number <n>', 'a number'), ['--number=42']), {\n    number: '42',\n  });\n  assert.deepEqual(parse((c) => c.option('-n, --number <n>', 'a number'), ['--number', '7']), {\n    number: '7',\n  });\n});\n\ntest('defaults apply only when the option is absent', () => {\n  assert.deepEqual(parse((c) => c.option('-p, --port <n>', 'port', '8080'), []), {\n    port: '8080',\n  });\n  assert.deepEqual(parse((c) => c.option('-p, --port <n>', 'port', '8080'), ['-p', '99']), {\n    port: '99',\n  });\n});\n\ntest('long flag names are camelcased into attribute names', () => {\n  assert.equal(new Option('--check-updates').attributeName(), 'checkUpdates');\n  assert.equal(new Option('-v, --verbose').attributeName(), 'verbose');\n  assert.equal(new Option('--dry-run-only').attributeName(), 'dry-run-only');\n  assert.deepEqual(parse((c) => c.option('--check-updates', 'check'), ['--check-updates']), {\n    checkUpdates: true,\n  });\n});\n\ntest('option kind is reported correctly', () => {\n  assert.equal(new Option('-v, --verbose').isBoolean(), true);\n  assert.equal(new Option('-n, --number <n>').isBoolean(), true);\n  assert.equal(new Option('-n, --number [n]').isBoolean(), false);\n  assert.equal(new Option('-n, --number <n>').required, true);\n  assert.equal(new Option('-n, --number [n]').optional, true);\n  assert.equal(new Option('-v, --verbose').required, false);\n});\n\ntest('an option recognises only its own flags', () => {\n  const option = new Option('-n, --number <n>');\n  assert.equal(option.is('-n'), true);\n  assert.equal(option.is('--number'), true);\n  assert.equal(option.is('-x'), true);\n  assert.equal(option.is('--other'), false);\n  assert.equal(new Option('--long-only').is('--long-only'), true);\n  assert.equal(new Option('--long-only').is('-l'), false);\n});\n\ntest('flags are split into short and long forms', () => {\n  const both = new Option('-n, --number <n>');\n  assert.equal(both.short, '-n');\n  assert.equal(both.long, '--number');\n  assert.equal(both.name(), 'number');\n  const longOnly = new Option('--number <n>');\n  assert.equal(longOnly.short, '--number');\n  assert.equal(longOnly.long, '--number');\n});\n\ntest('choices restrict the accepted values', () => {\n  assert.deepEqual(\n    parse((c) => c.addOption(new Option('--size <s>').choices(['small', 'large'])), [\n      '--size',\n      'small',\n    ]),\n    { size: 'small' },\n  );\n  assert.throws(() =>\n    parse((c) => c.addOption(new Option('--size <s>').choices(['small', 'large'])), [\n      '--size',\n      'huge',\n    ]),\n  );\n});","lineStart":1,"lineEnd":96,"totalLines":96,"truncated":false}},"title":"test/option.test.js","time":{"start":1787413612650,"end":1787413612693}},"id":"prt_02a2745ac001CMXVbDFXBRw5ny","sessionID":"ses_fd5d954e0ffemmfmsc0r3Dfivs","messageID":"msg_02a2738f3001Eu6EjRLnj3f6PB"}}
