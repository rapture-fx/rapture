es are a, b. true\nvariadic collect: [ 'a' ] [ 'a', 'b' ]\ncollect start: [ 'x' ] [ 'x', 'y' ]\n","exit":0,"truncated":false},"title":"node --input-type=module -e '\nimport { Argument, humanReadableArgName } from \"./lib/argument.js\";\nimport { InvalidArgumentError } from \"./lib/error.js\";\n\nconst a1 = new Argument(\"<first>\");\nconsole.log(\"name1:\", a1.name(), \"req:\", a1.required, \"var:\", a1.variadic, \"hr:\", humanReadableArgName(a1));\nconst a2 = new Argument(\"[rest...]\");\nconsole.log(\"name2:\", a2.name(), \"req:\", a2.required, \"var:\", a2.variadic, \"hr:\", humanReadableArgName(a2));\nconst a3 = new Argument(\"[opt]\");\nconsole.log(\"name3:\", a3.name(), \"hr:\", humanReadableArgName(a3));\nconst a4 = new Argument(\"<v...>\");\nconsole.log(\"name4:\", a4.name(), \"hr:\", humanReadableArgName(a4));\n\nconst c = new Argument(\"<x>\").choices([\"a\",\"b\"]);\nconsole.log(\"choices chainable:\", c instanceof Argument, \"copied:\", c.argChoices);\ntry { c.parseArg(\"z\",\"x\"); } catch(e){ console.log(\"err:\", e.message, e instanceof InvalidArgumentError); }\n\nconst v = new Argument(\"[r...]\").choices([\"a\",\"b\"]);\nconsole.log(\"variadic collect:\", v.parseArg(\"a\", v.defaultValue), v.parseArg(\"b\", [\"a\"]));\nconsole.log(\"collect start:\", v._collectValue(\"x\", v.defaultValue), v._collectValue(\"y\", [\"x\"]));\n'","time":{"start":1787414180495,"end":1787414180500}},"id":"prt_02a2fe182001v4wjyFmPzQrr3y","sessionID":"ses_fd5d122a6ffeKiP5ygtUtU48Sg","messageID":"msg_02a2fc88e001UU3WLIj0WJfb0m"}}
