ts/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-1-cli-suggest-similar-baseline-ae5644b9/lib/suggestSimilar.js","text":"const maxDistance = 3;\n\n/**\n * Find close matches, restricted to same number of edits.\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\n\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n  const similar = candidates.filter((candidate) => candidate === word);\n\n  if (similar.length === 1) {\n    return `\\n(Did you mean ${similar[0]}?)`;\n  }\n  return '';\n}","lineStart":1,"lineEnd":21,"totalLines":21,"truncated":false}},"title":"lib/suggestSimilar.js","time":{"start":1787413771762,"end":1787413771791}},"id":"prt_02a29b244001X5Uj1R3cwL5sfP","sessionID":"ses_fd5d666cdffeDaUv7E8AZCL6BW","messageID":"msg_02a299c69001814DhQ5kkZKSgM"}}
