{"type":"tool_use","timestamp":1787413787972,"sessionID":"ses_fd5d666cdffeDaUv7E8AZCL6BW","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-13e2b33b6e4043438310604b4e7598ed","state":{"status":"completed","input":{"content":"const maxDistance = 3;\n\n/**\n * Find close matches using Damerau-Levenshtein distance (adjacent transpositions\n * count as a single edit).\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\n\nfunction damerauLevenshtein(a, b) {\n  const al = a.length;\n  const bl = b.length;\n  const d = Array.from({ length: al + 1 }, () => new Array(bl + 1).fill(0));\n\n  for (let i = 0; i <= al; i++) d[i][0] = i;\n  for (let j = 0; j <= bl; j++) d[0][j] = j;\n\n  for (let i = 1; i <= al; i++) {\n    for (let j = 1; j <= bl; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      d[i][j] = Math.min(\n        d[i - 1][j] + 1,\n        d[i][j - 1] + 1,\n        d[i - 1][j - 1] + cost,\n      );\n      if (\n        i > 1 &&\n        j > 1 &&\n        a[i - 1] === b[j - 2] &&\n        a[i - 2] === b[j - 1]\n      ) {\n        d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);\n      }\n    }\n  }\n\n  return d[al][bl];\n}\n\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n  const target = searchingOptions ? word.slice(2) : word;\n\n  let bestDistance = Infinity;\n  let matches = [];\n\n  for (const candidate of candidates) {\n    if (candidate.length <= 1) continue;\n\n    const compare = searchingOptions ? candidate.replace(/^-+/, '') : candidate;\n    if (compare === target) continue;\n\n    const distance = damerauLevenshtein(target, compare);\n    if (distance > maxDistance) continue;\n\n    const longer = Math.max(target.length, compare.length);\n    if (longer === 0) continue;\n    const similarity = (longer - distance) / longer;\n    if (similarity <= 0.4) continue;\n\n    if (distance < bestDistance) {\n      bestDistance = distance;\n      matches = [candidate];\n    } else if (distance === bestDistance) {\n      matches.push(candidate);\n    }\n  }\n\n  const unique = [...new Set(matches)].sort((a, b) => a.localeCompare(b));\n\n  if (unique.length === 1) {\n    return `\\n(Did you mean ${unique[0]}?)`;\n  }\n  if (unique.length > 1) {\n    const list = unique.join(', ');\n    return `\\n(Did you mean one of ${list}?)`;\n  }\n  return '';\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-1-cli-suggest-similar-baseline-ae5644b9/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-1-cli-suggest-similar-baseline-ae5644b9/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787413787954,"end":1787413787969}},"id":"prt_02a29cd750012XvrNRRhbsD5rC","sessionID":"ses_fd5d666cdffeDaUv7E8AZCL6BW","messageID":"msg_02a29b6dd001cnpoeqPusTTLkx"}}
