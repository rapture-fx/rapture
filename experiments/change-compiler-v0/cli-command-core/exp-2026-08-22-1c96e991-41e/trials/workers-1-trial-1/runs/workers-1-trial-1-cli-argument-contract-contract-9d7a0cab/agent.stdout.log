8:    * @return {Argument}\n49:    */\n50: \n51:   default(value, description) {\n52:     this.defaultValue = value;\n53:     this.defaultValueDescription = description;\n54:   }\n55: \n56:   /**\n57:    * Set the custom handler for processing CLI command arguments into argument values.\n58:    *\n59:    * @param {Function} [fn]\n60:    * @return {Argument}\n61:    */\n62: \n63:   argParser(fn) {\n64:     this.parseArg = fn;\n65:   }\n66: \n67:   /**\n68:    * Only allow argument value to be one of choices.\n69:    *\n70:    * @param {string[]} values\n71:    * @return {Argument}\n72:    */\n73: \n74:   choices(values) {\n75:     this.argChoices = values;\n76:     return this;\n77:   }\n78: \n79:   /**\n80:    * Make argument required.\n81:    *\n82:    * @returns {Argument}\n83:    */\n84:   argRequired() {\n85:     this.required = true;\n86:     return this;\n87:   }\n88: \n89:   /**\n90:    * Make argument optional.\n91:    *\n92:    * @returns {Argument}\n93:    */\n94:   argOptional() {\n95:     this.required = false;\n96:     return this;\n97:   }\n98: }\n99: \n100: /**\n101:  * Takes an argument and returns its human readable equivalent for help usage.\n102:  *\n103:  * @param {Argument} arg\n104:  * @return {string}\n105:  * @private\n106:  */\n107: \n108: export function humanReadableArgName(arg) {\n109:   const nameOutput = arg.name() + (arg.variadic === true ? '...' : '');\n110: \n111:   return arg.required ? '<' + nameOutput + '>' : '[' + nameOutput + ']';\n112: }\n\n(End of file - total 112 lines)\n</content>","metadata":{"preview":"import { InvalidArgumentError } from './error.js';\n\nexport class Argument {\n  /**\n   * Initialize a new command argument with the given name and description.\n   * The default is that the argument is required, and you can explicitly\n   * indicate this with <> around the name. Put [] around the name for an optional argument.\n   *\n   * @param {string} name\n   * @param {string} [description]\n   */\n\n  constructor(name, description) {\n    this.description = description || '';\n    this.variadic = false;\n    this.parseArg = undefined;\n    this.defaultValue = undefined;\n    this.defaultValueDescription = undefined;\n    this.argChoices = undefined;\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-1-cli-argument-contract-contract-9d7a0cab/lib/argument.js","text":"import { InvalidArgumentError } from './error.js';\n\nexport class Argument {\n  /**\n   * Initialize a new command argument with the given name and description.\n   * The default is that the argument is required, and you can explicitly\n   * indicate this with <> around the name. Put [] around the name for an optional argument.\n   *\n   * @param {string} name\n   * @param {string} [description]\n   */\n\n  constructor(name, description) {\n    this.description = description || '';\n    this.variadic = false;\n    this.parseArg = undefined;\n    this.defaultValue = undefined;\n    this.defaultValueDescription = undefined;\n    this.argChoices = undefined;\n\n    this.required = true;\n    this._name = name;\n  }\n\n  /**\n   * Return argument name.\n   *\n   * @return {string}\n   */\n\n  name() {\n    return this._name;\n  }\n\n  /**\n   * @package\n   */\n\n  _collectValue(value) {\n    return value;\n  }\n\n  /**\n   * Set the default value, and optionally supply the description to be displayed in the help.\n   *\n   * @param {*} value\n   * @param {string} [description]\n   * @return {Argument}\n   */\n\n  default(value, description) {\n    this.defaultValue = value;\n    this.defaultValueDescription = description;\n  }\n\n  /**\n   * Set the custom handler for processing CLI command arguments into argument values.\n   *\n   * @param {Function} [fn]\n   * @return {Argument}\n   */\n\n  argParser(fn) {\n    this.parseArg = fn;\n  }\n\n  /**\n   * Only allow argument value to be one of choices.\n   *\n   * @param {string[]} values\n   * @return {Argument}\n   */\n\n  choices(values) {\n    this.argChoices = values;\n    return this;\n  }\n\n  /**\n   * Make argument required.\n   *\n   * @returns {Argument}\n   */\n  argRequired() {\n    this.required = true;\n    return this;\n  }\n\n  /**\n   * Make argument optional.\n   *\n   * @returns {Argument}\n   */\n  argOptional() {\n    this.required = false;\n    return this;\n  }\n}\n\n/**\n * Takes an argument and returns its human readable equivalent for help usage.\n *\n * @param {Argument} arg\n * @return {string}\n * @private\n */\n\nexport function humanReadableArgName(arg) {\n  const nameOutput = arg.name() + (arg.variadic === true ? '...' : '');\n\n  return arg.required ? '<' + nameOutput + '>' : '[' + nameOutput + ']';\n}","lineStart":1,"lineEnd":112,"totalLines":112,"truncated":false}},"title":"lib/argument.js","time":{"start":1787413703317,"end":1787413703343}},"id":"prt_02a28a698001Y0sLBJWiOfvIsD","sessionID":"ses_fd5d7767fffekaju9wTeSrqMaf","messageID":"msg_02a288cc9001dcv4Bb0IrPh1gL"}}
