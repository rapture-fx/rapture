{"type":"tool_use","timestamp":1787414080073,"sessionID":"ses_fd5d2b705ffeknIDebNDUjPyzF","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b855788bae05413280d943233ca8ef05","state":{"status":"completed","input":{"content":"const maxDistance = 3;\n\n/**\n * Restricted Damerau-Levenshtein distance: counts insertion, deletion,\n * substitution, and transposition of two adjacent characters as a single edit.\n *\n * @param {string} a\n * @param {string} b\n * @returns {number}\n */\n\nfunction editDistance(a, b) {\n  const lenA = a.length;\n  const lenB = b.length;\n\n  if (lenA === 0) return lenB;\n  if (lenB === 0) return lenA;\n\n  let prevPrev = null;\n  let prev = Array.from({ length: lenB + 1 }, (_, j) => j);\n\n  for (let i = 1; i <= lenA; i++) {\n    const curr = new Array(lenB + 1);\n    curr[0] = i;\n    for (let j = 1; j <= lenB; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      let val = Math.min(\n        prev[j] + 1,\n        curr[j - 1] + 1,\n        prev[j - 1] + cost,\n      );\n      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {\n        val = Math.min(val, prevPrev[j - 2] + 1);\n      }\n      curr[j] = val;\n    }\n    prevPrev = prev;\n    prev = curr;\n  }\n\n  return prev[lenB];\n}\n\n/**\n * Find close matches using edit distance similarity.\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\n\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n  const prefix = searchingOptions ? '--' : '';\n  const target = searchingOptions ? word.slice(2) : word;\n\n  let bestDistance = Infinity;\n  let best = [];\n  const seen = new Set();\n\n  for (const candidate of candidates) {\n    const candCompare = searchingOptions && candidate.startsWith('--')\n      ? candidate.slice(2)\n      : candidate;\n\n    if (seen.has(candCompare)) continue;\n    seen.add(candCompare);\n\n    if (candCompare.length <= 1) continue;\n\n    const distance = editDistance(target, candCompare);\n    if (distance > maxDistance) continue;\n\n    const longer = Math.max(target.length, candCompare.length);\n    const similarity = (longer - distance) / longer;\n    if (similarity <= 0.4) continue;\n\n    if (distance < bestDistance) {\n      bestDistance = distance;\n      best = [candCompare];\n    } else if (distance === bestDistance) {\n      best.push(candCompare);\n    }\n  }\n\n  if (best.length === 0) return '';\n\n  best.sort((a, b) => a.localeCompare(b));\n\n  const output = best.map((c) => `${prefix}${c}`);\n\n  if (output.length === 1) {\n    return `\\n(Did you mean ${output[0]}?)`;\n  }\n  return `\\n(Did you mean one of ${output.join(', ')}?)`;\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-1-cli-suggest-similar-contract-99194056/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/cli-command-core/exp-2026-08-22-1c96e991-41e/.worktrees/workers-1-trial-1-cli-suggest-similar-contract-99194056/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787414080038,"end":1787414080071}},"id":"prt_02a2e470f001RgANlBPLuia3XM","sessionID":"ses_fd5d2b705ffeknIDebNDUjPyzF","messageID":"msg_02a2e3a7d001vFabiMGrDzW4JJ"}}
