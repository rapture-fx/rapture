-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-ignore-callbacks-contract-b17d046c/index.js","text":"'use strict';\n\nconst pico = require('./lib/glob-match');\nconst utils = require('./lib/utils');\n\nfunction globMatch(glob, options, returnState = false) {\n  // default to os.platform()\n  if (options && (options.windows === null || options.windows === undefined)) {\n    // don't mutate the original options object\n    options = { ...options, windows: utils.isWindows() };\n  }\n\n  return pico(glob, options, returnState);\n}\n\nObject.assign(globMatch, pico);\nmodule.exports = globMatch;","lineStart":1,"lineEnd":17,"totalLines":17,"truncated":false}},"title":"index.js","time":{"start":1787413349394,"end":1787413349434}},"id":"prt_02a2341ef0016iwGOZgFts270A","sessionID":"ses_fd5de0bedffeII2FwqH8SyHTad","messageID":"msg_02a23366e001pujuYTel3ROutJ"}}
