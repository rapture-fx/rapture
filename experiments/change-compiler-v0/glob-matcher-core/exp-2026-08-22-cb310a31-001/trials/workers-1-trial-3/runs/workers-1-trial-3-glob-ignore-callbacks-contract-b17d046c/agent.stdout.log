) callbacks.onMatch(result);\n  if (ignored && callbacks.onIgnore) callbacks.onIgnore(result);\n\n  return returnObject ? result : isMatch;\n};"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-ignore-callbacks-contract-b17d046c/lib/glob-match.js\n===================================================================\n--- /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-ignore-callbacks-contract-b17d046c/lib/glob-match.js\n+++ /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-ignore-callbacks-contract-b17d046c/lib/glob-match.js\n@@ -6,8 +6,46 @@\n const constants = require('./constants');\n const isObject = val => val && typeof val === 'object' && !Array.isArray(val);\n \n /**\n+ * Applies ignore patterns and lifecycle callbacks to the outcome of matching\n+ * a single input. The `result` argument is the raw result object produced by\n+ * the matcher (or `null` when the input never matched the pattern). Returns\n+ * the final value: the result object when `returnObject` is true, otherwise a\n+ * boolean reflecting the final decision (`isMatch`).\n+ *\n+ * Rules:\n+ *  - an input that never matched the pattern is a non-match, never ignored;\n+ *  - an input that matched the pattern but also matches an ignore pattern is\n+ *    excluded (reported as a non-match via `isMatch: false`) and `onIgnore` fires;\n+ *  - callbacks are always invoked with the result object, never with the caller's\n+ *    own callbacks leaked into the ignore matcher.\n+ */\n+const applyOutcome = (input, result, returnObject, ignoreMatcher, callbacks, glob) => {\n+  c