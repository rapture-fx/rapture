ase) are still passed through so the\n  // ignore patterns are evaluated under the same semantics as the pattern.\n  let ignoreMatcher = null;\n  if (opts.ignore !== undefined && opts.ignore !== null) {\n    const ignoreOptions = { ...opts };\n    delete ignoreOptions.onResult;\n    delete ignoreOptions.onMatch;\n    delete ignoreOptions.onIgnore;\n    delete ignoreOptions.ignore;\n    ignoreMatcher = globMatch(opts.ignore, ignoreOptions);\n  }\n\n  const callbacks = {\n    onResult: opts.onResult,\n    onMatch: opts.onMatch,\n    onIgnore: opts.onIgnore\n  };\n\n  if (Array.isArray(glob)) {\n    // Strip callbacks/ignore before recursing so sub-matchers don't re-fire\n    // them; the array matcher applies them once at its own level.\n    const subOptions = { ...opts };\n    delete subOptions.onResult;\n    delete subOptions.onMatch;\n    delete subOptions.onIgnore;\n    delete subOptions.ignore;\n\n    const fns = glob.map(input => globMatch(input, subOptions, returnState));\n    const arrayMatcher = (str, returnObject = false) => {\n      let matchedResult = null;\n      for (const fn of fns) {\n        const res = fn(str, true);\n        if (res && res.isMatch) {\n          matchedResult = res;\n          break;\n        }\n      }\n      return applyOutcome(str, matchedResult, returnObject, ignoreMatcher, callbacks, glob);\n    };\n    return arrayMatcher;\n  }\n\n  const isState = isObject(glob) && glob.tokens && glob.input;\n\n  if (glob === '' || (typeof glob !== 'string' && !isState)) {\n    throw new TypeError('Expected pattern to be a non-empty string');\n  }\n\n  const posix = opts.windows;\n  const regex = isState\n    ? globMatch.compileRe(glob, options)\n    : globMatch.makeRe(glob, options, false, true);\n\n  const state = regex.state;\n  delete regex.state;\n\n  const matcher = (input, returnObject = false) => {\n    const { isMatch, match, output } = globMatch.test(input, regex, options, { glob, posix });\n    const result = { glob, state, regex, posix, input, output, match, isMatch };\n    return applyOutcome(input, isMatch ? result : null, returnObject, ignoreMatcher, callbacks, glob);\n  };\n\n  if (returnState) {\n    matcher.state = state;\n  }\n\n  return matcher;\n};"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-ignore-callbacks-contract-b17d046c/lib/glob-match.js\n===================================================================\n--- /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-ignore-callbacks-contract-b17d046c/lib/glob-match.js\n+++ /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-ignore-callbacks-contract-b17d046c/lib/glob-match.js\n@@ -77,16 +77,49 @@\n  * @api public\n  */\n \n const globMatch = (glob, options, returnState = false) => {\n+  const opts = options || {};\n+\n+  // Build the ignore matcher without inheriting the caller's own callbacks.\n+  // Matching options (e.g. windows/nocase) are still passed through so the\n+  // ignore patterns are evaluated under the same semantics as the pattern.\n+  let ignoreMatcher = null;\n+  if (opts.ignore !== undefined && opts.ignore !== null) {\n+    const ignoreOptions = { ...opts };\n+    delete ignoreOptions.onResult;\n+    delete ignoreOptions.onMatch;\n+    delete ignoreOptions.onIgnore;\n+    delete ignoreOptions.ignore;\n+    ignoreMatcher = globMatch(opts.ignore, ignoreOptions);\n+  }\n+\n+  const callbacks = {\n+    onResult: opts.onResult,\n+    onMatch: opts.onMatch,\n+    onIgnore: opts.onIgnore\n+  };\n+\n   if (Array.isArray(glob)) {\n-    const fns = glob.map(input => globMatch(input, options, 