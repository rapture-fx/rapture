{"type":"tool_use","timestamp":1787413137595,"sessionID":"ses_fd5e0e81dffeEQ5Jm66Y20Qkyc","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-4f363f41b90e4032ab9054e9a5e6303a","state":{"status":"completed","input":{"filePath":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-utils-helpers-baseline-af63b3c5/test/match.test.js"},"output":"<path>/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-utils-helpers-baseline-af63b3c5/test/match.test.js</path>\n<type>file</type>\n<content>\n1: 'use strict'\n2: \n3: const test = require('node:test')\n4: const assert = require('node:assert/strict')\n5: \n6: const glob = require('../index.js')\n7: \n8: test('matches simple wildcard patterns', () => {\n9:   assert.equal(glob.isMatch('a.js', '*.js'), true)\n10:   assert.equal(glob.isMatch('index.js', '*.js'), true)\n11:   assert.equal(glob.isMatch('a/b', 'a/*'), true)\n12: })\n13: \n14: test('rejects paths outside the pattern', () => {\n15:   assert.equal(glob.isMatch('a.md', '*.js'), false)\n16:   assert.equal(glob.isMatch('a/b/c', 'a/*'), true)\n17:   assert.equal(glob.isMatch('b/a.js', '*.js'), false)\n18: })\n19: \n20: test('globstar crosses path separators', () => {\n21:   assert.equal(glob.isMatch('a/b/c.js', '**/*.js'), true)\n22:   assert.equal(glob.isMatch('a.js', '**/*.js'), true)\n23:   assert.equal(glob.isMatch('a/b/c', 'a/**'), true)\n24:   assert.equal(glob.isMatch('b/c', 'a/**'), false)\n25: })\n26: \n27: test('supports extglobs and negated extglobs', () => {\n28:   assert.equal(glob.isMatch('a', '@(a|b)'), true)\n29:   assert.equal(glob.isMatch('c', '@(a|b)'), true)\n30:   assert.equal(glob.isMatch('a', '!(a|b)'), true)\n31:   assert.equal(glob.isMatch('c', '!(a|b)'), true)\n32: })\n33: \n34: test('a leading bang negates the whole pattern', () => {\n35:   assert.equal(glob.isMatch('a.js', '!*.js'), true)\n36:   assert.equal(glob.isMatch('a.md', '!*.js'), true)\n37: })\n38: \n39: test('supports braces and bracket ranges', () => {\n40:   assert.equal(glob.isMatch('a/c', '{a,b}/c'), true)\n41:   assert.equal(glob.isMatch('d/c', '{a,b}/c'), false)\n42:   assert.equal(glob.isMatch('b/d', '[a-c]/d'), true)\n43:   assert.equal(glob.isMatch('z/d', '[a-c]/d'), false)\n44: })\n45: \n46: test('matchBase compares only the final segment', () => {\n47:   assert.equal(glob.matchBase('a/b/c.js', '*.js'), true)\n48:   assert.equal(glob.matchBase('a/b/c.md', '*.js'), true)\n49: })\n50: \n51: test('scan splits a pattern into its static base and glob parts', () => {\n52:   const scanned = glob.scan('a/b/*.js')\n53:   assert.equal(scanned.base, 'a/b')\n54:   assert.equal(scanned.glob, '*.js')\n55:   assert.equal(scanned.isGlob, true)\n56:   assert.equal(scanned.negated, false)\n57: \n58:   const negated = glob.scan('!a/b/*.js')\n59:   assert.equal(negated.negated, true)\n60:   assert.equal(negated.prefix, '')\n61:   assert.equal(negated.base, 'a/b')\n62: \n63:   const literal = glob.scan('a/b/c')\n64:   assert.equal(literal.isGlob, false)\n65:   assert.equal(literal.base, 'a/b/c')\n66: })\n\n(End of file - total 66 lines)\n</content>","metadata":{"preview":"'use strict'\n\nconst test = require('node:test')\nconst assert = require('node:assert/strict')\n\nconst glob = require('../index.js')\n\ntest('matches simple wildcard patterns', () => {\n  assert.equal(glob.isMatch('a.js', '*.js'), true)\n  assert.equal(glob.isMatch('index.js', '*.js'), true)\n  assert.equal(glob.isMatch('a/b', 'a/*'), true)\n})\n\ntest('rejects paths outside the pattern', () => {\n  assert.equal(glob.isMatch('a.md', '*.js'), false)\n  assert.equal(glob.isMatch('a/b/c', 'a/*'), true)\n  assert.equal(glob.isMatch('b/a.js', '*.js'), false)\n})\n\ntest('globstar crosses path separators', () => {","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-3-glob-utils-helpers-baseline-af63b3c5/test/match.test.js","text":"'use strict'\n\nconst test = require('node:test')\nconst assert = require('node:assert/strict')\n\nconst glob = require('../index.js')\n\ntest('matches simple wildcard patterns', () => {\n  assert.equal(glob.isMatch('a.js', '*.js'), true)\n  assert.equal(glob.isMatch('index.js', '*.js'), true)\n  assert.equal(glob.isMatch('a/b', 'a/*'), true)\n})\n\ntest('rejects paths outside the pattern', () => {\n  assert.equal(glob.isMatch('a.md', '*.js'), false)\n  assert.equal(glob.isMatch('a/b/c', 'a/*'), true)\n  assert.equal(glob.isMatch('b/a.js', '*.js'), false)\n})\n\ntest('globstar crosses path separators', () => {\n  assert.equal(glob.isMatch('a/b/c.js', '**/*.js'), true)\n  assert.equal(glob.isMatch('a.js', '**/*.js'), true)\n  assert.equal(glob.isMatch('a/b/c', 'a/**'), true)\n  assert.equal(glob.isMatch('b/c', 'a/**'), false)\n})\n\ntest('supports extglobs and negated extglobs', () => {\n  assert.equal(glob.isMatch('a', '@(a|b)'), true)\n  assert.equal(glob.isMatch('c', '@(a|b)'), true)\n  assert.equal(glob.isMatch('a', '!(a|b)'), true)\n  assert.equal(glob.isMatch('c', '!(a|b)'), true)\n})\n\ntest('a leading bang negates the whole pattern', () => {\n  assert.equal(glob.isMatch('a.js', '!*.js'), true)\n  assert.equal(glob.isMatch('a.md', '!*.js'), true)\n})\n\ntest('supports braces and bracket ranges', () => {\n  assert.equal(glob.isMatch('a/c', '{a,b}/c'), true)\n  assert.equal(glob.isMatch('d/c', '{a,b}/c'), false)\n  assert.equal(glob.isMatch('b/d', '[a-c]/d'), true)\n  assert.equal(glob.isMatch('z/d', '[a-c]/d'), false)\n})\n\ntest('matchBase compares only the final segment', () => {\n  assert.equal(glob.matchBase('a/b/c.js', '*.js'), true)\n  assert.equal(glob.matchBase('a/b/c.md', '*.js'), true)\n})\n\ntest('scan splits a pattern into its static base and glob parts', () => {\n  const scanned = glob.scan('a/b/*.js')\n  assert.equal(scanned.base, 'a/b')\n  assert.equal(scanned.glob, '*.js')\n  assert.equal(scanned.isGlob, true)\n  assert.equal(scanned.negated, false)\n\n  const negated = glob.scan('!a/b/*.js')\n  assert.equal(negated.negated, true)\n  assert.equal(negated.prefix, '')\n  assert.equal(negated.base, 'a/b')\n\n  const literal = glob.scan('a/b/c')\n  assert.equal(literal.isGlob, false)\n  assert.equal(literal.base, 'a/b/c')\n})","lineStart":1,"lineEnd":66,"totalLines":66,"truncated":false}},"title":"test/match.test.js","time":{"start":1787413137582,"end":1787413137592}},"id":"prt_02a200606001wCfhKlRI0YgGow","sessionID":"ses_fd5e0e81dffeEQ5Jm66Y20Qkyc","messageID":"msg_02a1ff4a1001eaytnN72RXfS66"}}
