nMatch(result);\n    if (ignored && onIgnore) onIgnore(result);\n\n    return returnObject ? result : matched;\n  };\n\n  if (returnState) {\n    matcher.state = state;\n  }\n\n  return matcher;\n};"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-1-glob-ignore-callbacks-contract-94c5332b/lib/glob-match.js\n===================================================================\n--- /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-1-glob-ignore-callbacks-contract-94c5332b/lib/glob-match.js\n+++ /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-1-glob-ignore-callbacks-contract-94c5332b/lib/glob-match.js\n@@ -59,17 +59,44 @@\n  * @api public\n  */\n \n const globMatch = (glob, options, returnState = false) => {\n+  const opts = options || {};\n+\n   if (Array.isArray(glob)) {\n-    const fns = glob.map(input => globMatch(input, options, returnState));\n-    const arrayMatcher = str => {\n-      for (const isMatch of fns) {\n-        const state = isMatch(str);\n-        if (state) return state;\n+    const fns = glob.map(input => globMatch(input, stripLifecycle(opts), returnState));\n+    const ignoreMatcher = buildIgnoreMatcher(opts);\n+    const { onResult, onMatch, onIgnore } = getLifecycle(opts);\n+\n+    const arrayMatcher = (str, returnObject = false) => {\n+      let result = null;\n+      for (const fn of fns) {\n+        const res = fn(str, true);\n+        if (res.isMatch) {\n+          result = res;\n+          break;\n+        }\n       }\n-      return false;\n+\n+      let matched = result ? result.isMatch : false;\n+      let ignored = false;\n+ 