ssert.equal(scanned.glob, '*.js')\n  assert.equal(scanned.isGlob, true)\n  assert.equal(scanned.negated, false)\n\n  const negated = glob.scan('!a/b/*.js')\n  assert.equal(negated.negated, true)\n  assert.equal(negated.prefix, '')","lineStart":1,"lineEnd":60,"totalLines":66,"truncated":true}},"title":"test/match.test.js","time":{"start":1787412478070,"end":1787412478078}},"id":"prt_02a15f3cb001cV4agAYYA9raLL","sessionID":"ses_fd5ea5379ffeljFyMS5ZkLq4V9","messageID":"msg_02a15e7760019cohuIAfSvYfj6"}}
