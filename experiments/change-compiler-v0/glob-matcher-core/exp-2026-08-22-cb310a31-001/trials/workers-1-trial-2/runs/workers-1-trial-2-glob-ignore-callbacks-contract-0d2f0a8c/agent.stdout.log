-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-2-glob-ignore-callbacks-contract-0d2f0a8c/index.js","text":"'use strict';\n\nconst pico = require('./lib/glob-match');\nconst utils = require('./lib/utils');\n\nfunction globMatch(glob, options, returnState = false) {\n  // default to os.platform()\n  if (options && (options.windows === null || options.windows === undefined)) {\n    // don't mutate the original options object\n    options = { ...options, windows: utils.isWindows() };\n  }\n\n  return pico(glob, options, returnState);\n}\n\nObject.assign(globMatch, pico);\nmodule.exports = globMatch;","lineStart":1,"lineEnd":17,"totalLines":17,"truncated":false}},"title":"index.js","time":{"start":1787412676166,"end":1787412676191}},"id":"prt_02a18fc36001NWflDEt5K737vG","sessionID":"ses_fd5e7cfd4ffeOqqpgv74UZAkcv","messageID":"msg_02a18ec00001NHC5GcDdROEEOg"}}
