/ you can still configure the matcher function to accept windows paths\n32:  * const isMatch = globMatch('a/*', { options: windows });\n33:  * console.log(isMatch('a\\\\b')); //=> true\n34:  * console.log(isMatch('a/b')); //=> true\n35:  * ```\n36:  * @param {String|Array} `globs` One or more glob patterns.\n37:  * @param {Object=} `options`\n38:  * @return {Function=} Returns a matcher function.\n39:  * @api public\n40:  */\n41: \n42: const globMatch = (glob, options, returnState = false) => {\n43:   if (Array.isArray(glob)) {\n44:     const fns = glob.map(input => globMatch(input, options, returnState));\n45:     const arrayMatcher = str => {\n46:       for (const isMatch of fns) {\n47:         const state = isMatch(str);\n48:         if (state) return state;\n49:       }\n50:       return false;\n51:     };\n52:     return arrayMatcher;\n53:   }\n54: \n55:   const isState = isObject(glob) && glob.tokens && glob.input;\n56: \n57:   if (glob === '' || (typeof glob !== 'string' && !isState)) {\n58:     throw new TypeError('Expected pattern to be a non-empty string');\n59:   }\n60: \n61:   const opts = options || {};\n62:   const posix = opts.windows;\n63:   const regex = isState\n64:     ? globMatch.compileRe(glob, options)\n65:     : globMatch.makeRe(glob, options, false, true);\n66: \n67:   const state = regex.state;\n68:   delete regex.state;\n69: \n70:   const matcher = (input, returnObject = false) => {\n71:     const { isMatch, match, output } = globMatch.test(input, regex, options, { glob, posix });\n72:     const result = { glob, state, regex, posix, input, output, match, isMatch };\n73: \n74:     if (isMatch === false) {\n75:       result.isMatch = false;\n76:       return returnObject ? result : false;\n77:     }\n78: \n79:     return returnObject ? result : true;\n80:   };\n81: \n82:   if (returnState) {\n83:     matcher.state = state;\n84:   }\n85: \n86:   return matcher;\n87: };\n88: \n89: /**\n90:  * Test `input` with the given `regex`. This is used by the main\n91:  * `globMatch()` function to test the input string.\n92:  *\n93:  * ```js\n94:  * const globMatch = require('globMatch');\n95:  * // globMatch.test(input, regex[, options]);\n96:  *\n97:  * console.log(globMatch.test('foo/bar', /^(?:([^/]*?)\\/([^/]*?))$/));\n98:  * // { isMatch: true, match: [ 'foo/', 'foo', 'bar' ], output: 'foo/bar' }\n99:  * ```\n100:  * @param {String} `input` String to test.\n101:  * @param {RegExp} `regex`\n102:  * @return {Object} Returns an object with matching info.\n103:  * @api public\n104:  */\n105: \n106: globMatch.test = (input, regex, options, { glob, posix } = {}) => {\n107:   if (typeof input !== 'string') {\n108:     throw new TypeError('Expected input to be a string');\n109:   }\n110: \n111:   if (input === '') {\n112:     return { isMatch: false, output: '' };\n113:   }\n114: \n115:   const opts = options || {};\n116:   const format = opts.format || (posix ? utils.toPosixSlashes : null);\n117:   let match = input === glob;\n118:   let output = (match && format) ? format(input) : input;\n119: \n120:   if (match === false) {\n121:     output = format ? format(input) : input;\n122:     match = output === glob;\n123:   }\n124: \n125:   if (match === false || opts.capture === true) {\n126:     if (opts.matchBase === true || opts.basename === true) {\n127:       match = globMatch.matchBase(input, regex, options, posix);\n128:     } else {\n129:       match = regex.exec(output);\n130:     }\n131:   }\n132: \n133:   return { isMatch: Boolean(match), match, output };\n134: };\n135: \n136: /**\n137:  * Match the basename of a filepath.\n138:  *\n139:  * ```js\n140:  * const globMatch = require('globMatch');\n141:  * // globMatch.matchBase(input, glob[, options]);\n142:  * console.log(globMatch.matchBase('foo/bar.js', '*.js'); // true\n143:  * ```\n144:  * @param {String} `input` String to test.\n145:  * @param {RegExp|String} `glob` Glob pattern or regex created by [.makeRe](#makeRe).\n146:  * @return {Boolean}\n147:  * @api public\n148:  */\n149: \n150: globMatch.matchBase = (input, glob, options, posix = options && options.windows) => {\n151:   const regex = glob instanceof RegExp ? glob : globMatch.makeRe(glob, options);\n152:   return regex.test(utils.basename(input, { windows: posix }));\n153: };\n154: \n155: /**\n156:  * Returns true if **any** of the given glob `patterns` match the specified `string`.\n157:  *\n158:  * ```js\n159:  * const globMatch = require('globMatch');\n160:  * // globMatch.isMatch(string, patterns[, options]);\n161:  *\n162:  * console.log(globMatch.isMatch('a.a', ['b.*', '*.a'])); //=> true\n163:  * console.log(globMatch.isMatch('a.a', 'b.*')); //=> false\n164:  * ```\n165:  * @param {String|Array} str The string to test.\n166:  * @param {String|Array} patterns One or more glob patterns to use for matching.\n167:  * @param {Object} [options] See available [options](#options).\n168:  * @return {Boolean} Returns true if any patterns match `str`\n169:  * @api public\n170:  */\n171: \n172: globMatch.isMatch = (str, patterns, options) => globMatch(patterns, options)(str);\n173: \n174: /**\n175:  * Parse a glob pattern to create the source string for a regular\n176:  * expression.\n177:  *\n178:  * ```js\n179:  * const globMatch = require('globMatch');\n180:  * const result = globMatch.parse(pattern[, options]);\n181:  * ```\n182:  * @param {String} `pattern`\n183:  * @param {Object} `options`\n184:  * @return {Object} Returns an object with useful properties and output to be used as a regex source string.\n185:  * @api public\n186:  */\n187: \n188: globMatch.parse = (pattern, options) => {\n189:   if (Array.isArray(pattern)) return pattern.map(p => globMatch.parse(p, options));\n190:   return parse(pattern, { ...options, fastpaths: false });\n191: };\n192: \n193: /**\n194:  * Scan a glob pattern to separate the pattern into segments.\n195:  *\n196:  * ```js\n197:  * const globMatch = require('globMatch');\n198:  * // globMatch.scan(input[, options]);\n199:  *\n200:  * const result = globMatch.scan('!./foo/*.js');\n201:  * console.log(result);\n202:  * { prefix: '!./',\n203:  *   input: '!./foo/*.js',\n204:  *   start: 3,\n205:  *   base: 'foo',\n206:  *   glob: '*.js',\n207:  *   isBrace: false,\n208:  *   isBracket: false,\n209:  *   isGlob: true,\n210:  *   isExtglob: false,\n211:  *   isGlobstar: false,\n212:  *   negated: true }\n213:  * ```\n214:  * @param {String} `input` Glob pattern to scan.\n215:  * @param {Object} `options`\n216:  * @return {Object} Returns an object with\n217:  * @api public\n218:  */\n219: \n220: globMatch.scan = (input, options) => scan(input, options);\n221: \n222: /**\n223:  * Compile a regular expression from the `state` object returned by the\n224:  * [parse()](#parse) method.\n225:  *\n226:  * ```js\n227:  * const globMatch = require('globMatch');\n228:  * const state = globMatch.parse('*.js');\n229:  * // globMatch.compileRe(state[, options]);\n230:  *\n231:  * console.log(globMatch.compileRe(state));\n232:  * //=> /^(?:(?!\\.)(?=.)[^/]*?\\.js)$/\n233:  * ```\n234:  * @param {Object} `state`\n235:  * @param {Object} `options`\n236:  * @param {Boolean} `returnOutput` Intended for implementors, this argument allows you to return the raw output from the parser.\n237:  * @param {Boolean} `returnState` Adds the state to a `state` property on the returned regex. Useful for implementors and debugging.\n238:  * @return {RegExp}\n239:  * @api public\n240:  */\n241: \n242: globMatch.compileRe = (state, options, returnOutput = false, returnState = false) => {\n243:   if (returnOutput === true) {\n244:     return state.output;\n245:   }\n246: \n247:   const opts = options || {};\n248:   const prepend = opts.contains ? '' : '^';\n249:   const append = opts.contains ? '' : '$';\n250: \n251:   let source = `${prepend}(?:${state.output})${append}`;\n252:   if (state && state.negated === true) {\n253:     source = `^(?!${source}).*$`;\n254:   }\n255: \n256:   const regex = globMatch.toRegex(source, options);\n257:   if (returnState === true) {\n258:     regex.state = state;\n259:   }\n260: \n261:   return regex;\n262: };\n263: \n264: /**\n265:  * Create a regular expression from a parsed glob pattern.\n266:  *\n267:  * ```js\n268:  * const globMatch = require('globMatch');\n269:  * // globMatch.makeRe(state[, options]);\n270:  *\n271:  * const result = globMatch.makeRe('*.js');\n272:  * console.log(result);\n273:  * //=> /^(?:(?!\\.)(?=.)[^/]*?\\.js)$/\n274:  * ```\n275:  * @param {String} `state` The object returned from the `.parse` method.\n276:  * @param {Object} `options`\n277:  * @param {Boolean} `returnOutput` Implementors may use this argument to return the compiled output, instead of a regular expression. This is not exposed on the options to prevent end-users from mutating the result.\n278:  * @param {Boolean} `returnState` Implementors may use this argument to return the state from the parsed glob with the returned regular expression.\n279:  * @return {RegExp} Returns a regex created from the given pattern.\n280:  * @api public\n281:  */\n282: \n283: globMatch.makeRe = (input, options = {}, returnOutput = false, returnState = false) => {\n284:   if (!input || typeof input !== 'string') {\n285:     throw new TypeError('Expected a non-empty string');\n286:   }\n287: \n288:   let parsed = { negated: false, fastpaths: true };\n289: \n290:   if (options.fastpaths !== false && (input[0] === '.' || input[0] === '*')) {\n291:     parsed.output = parse.fastpaths(input, options);\n292:   }\n293: \n294:   if (!parsed.output) {\n295:     parsed = parse(input, options);\n296:   }\n297: \n298:   return globMatch.compileRe(parsed, options, returnOutput, returnState);\n299: };\n300: \n301: /**\n302:  * Create a regular expression from the given regex source string.\n303:  *\n304:  * ```js\n305:  * const globMatch = require('globMatch');\n306:  * // globMatch.toRegex(source[, options]);\n307:  *\n308:  * const { output } = globMatch.parse('*.js');\n309:  * console.log(