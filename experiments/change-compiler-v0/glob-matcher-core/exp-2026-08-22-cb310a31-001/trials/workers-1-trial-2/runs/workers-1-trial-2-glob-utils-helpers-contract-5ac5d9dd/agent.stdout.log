"b\"\nbase3: \"c\"\nbase4: \"b\"\nbase5: \"b\"\nesc1: \"a\\\\[b\"\nesc2: \"a\\\\[b\"\nesc3: \"a[b\\\\[c\"\nesc4: \"a\\\\[b\\\\[c\"\nrm1: \"foo\" {\"prefix\":\"./\"}\nrm2: \"foo\" {}\nrm3: \"foo\"\n","exit":0,"truncated":false},"title":"cd /Users/wira/Documents/rapture/rapture-change-compiler-v0/experiments/change-compiler-v0/glob-matcher-core/exp-2026-08-22-cb310a31-001/.worktrees/workers-1-trial-2-glob-utils-helpers-contract-5ac5d9dd && node -e '\nconst u = require(\"./lib/utils\");\n// basename\nconsole.log(\"base1:\", JSON.stringify(u.basename(\"a/b/c.js\"))); // c.js\nconsole.log(\"base2:\", JSON.stringify(u.basename(\"a/b/\"))); // b\nconsole.log(\"base3:\", JSON.stringify(u.basename(\"a\\\\b\\\\c\", {windows:true}))); // c\nconsole.log(\"base4:\", JSON.stringify(u.basename(\"a/b\", {windows:true}))); // b (no backslash sep)\nconsole.log(\"base5:\", JSON.stringify(u.basename(\"a\\\\b\\\\\", {windows:true}))); // b\n// escapeLast\nconsole.log(\"esc1:\", JSON.stringify(u.escapeLast(\"a[b\", \"[\", 2))); // a\\\\[b\nconsole.log(\"esc2:\", JSON.stringify(u.escapeLast(\"a\\\\[b\", \"[\", 3))); // a\\\\[b (already escaped, skip -> nothing since only one)\nconsole.log(\"esc3:\", JSON.stringify(u.escapeLast(\"a[b[c\", \"[\", 4))); // a[b\\\\[c\nconsole.log(\"esc4:\", JSON.stringify(u.escapeLast(\"a\\\\[b[c\", \"[\", 5))); // a\\\\[b\\\\[c\n// removePrefix\nconst st={}; console.log(\"rm1:\", JSON.stringify(u.removePrefix(\"./foo\", st)), JSON.stringify(st)); // foo, {prefix:\"./\"}\nconst st2={}; console.log(\"rm2:\", JSON.stringify(u.removePrefix(\"foo\", st2)), JSON.stringify(st2)); // foo, {}\nconsole.log(\"rm3:\", JSON.stringify(u.removePrefix(\"./foo\"))); // foo, works without state\n'\n","time":{"start":1787413043332,"end":1787413043337}},"id":"prt_02a1e85ab001UgkWY0pCl4ngw2","sessionID":"ses_fd5e3077cffe3NQNTovEhltPeF","messageID":"msg_02a1e424f001jnBJh4HrM9cdL3"}}
