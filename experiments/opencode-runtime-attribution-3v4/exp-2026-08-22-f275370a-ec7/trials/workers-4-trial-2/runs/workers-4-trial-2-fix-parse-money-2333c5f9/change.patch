diff --git a/src/money.ts b/src/money.ts
index d079d6d03d3724f135f2c174f8866942e262ba41..1d47aaa2bbdba7716d403d37a219aa44efe13d47 100644
--- a/src/money.ts
+++ b/src/money.ts
@@ -1,7 +1,28 @@
 export function parseMoney(input: string): number {
-  const digits = input.replace(/[^0-9-]/g, "");
-  if (digits.length === 0 || digits === "-") {
+  if (typeof input !== "string" || input.trim().length === 0) {
     throw new TypeError("invalid money amount");
   }
-  return Number.parseInt(digits, 10);
+
+  const trimmed = input.trim();
+  const match = /^[-+]?\$?\s*(\d{1,3}(?:,\d{3})*(?:\.\d+)?|\d+(?:\.\d+)?)$/.exec(
+    trimmed,
+  );
+  if (match === null) {
+    throw new TypeError("invalid money amount");
+  }
+
+  const normalized = match[1].replace(/,/g, "");
+  const negative = trimmed.trimStart().startsWith("-");
+
+  const [intPart, fracPart = ""] = normalized.split(".");
+  const centsDigits = (fracPart + "00").slice(0, 2);
+  const roundDigit = fracPart.length > 2 ? fracPart[2] : "0";
+
+  let cents = Number.parseInt(intPart, 10) * 100 + Number.parseInt(centsDigits, 10);
+  if (roundDigit >= "5") {
+    cents += 1;
+  }
+
+  const value = cents / 100;
+  return negative ? -value : value;
 }
