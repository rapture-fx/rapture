\n});","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/wira/Documents/rapture/rapture-provider-runtime-attribution/experiments/opencode-runtime-attribution-3v4/exp-2026-08-22-f275370a-ec7/.worktrees/workers-4-trial-4-fix-parse-money-b6b1ff33/tests/money.test.ts","text":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { parseMoney } from \"../src/money.ts\";\n\ntest(\"parses dollar and comma-formatted amounts to cents-rounded dollars\", () => {\n  assert.equal(parseMoney(\"$12.50\"), 12.5);\n  assert.equal(parseMoney(\"12.50\"), 12.5);\n  assert.equal(parseMoney(\"0.99\"), 0.99);\n  assert.equal(parseMoney(\"1,234.56\"), 1234.56);\n});\n\ntest(\"rejects empty and non-numeric input\", () => {\n  assert.throws(() => parseMoney(\"\"), TypeError);\n  assert.throws(() => parseMoney(\"abc\"), TypeError);\n});","lineStart":1,"lineEnd":15,"totalLines":15,"truncated":false}},"title":"tests/money.test.ts","time":{"start":1787362207815,"end":1787362207943}},"id":"prt_02716e467001gIys8ajXwlJB07","sessionID":"ses_fd8e9980cffegx3VDrSwpfwa1d","messageID":"msg_02716d64e0019saI9MYBS01Zrc"}}
