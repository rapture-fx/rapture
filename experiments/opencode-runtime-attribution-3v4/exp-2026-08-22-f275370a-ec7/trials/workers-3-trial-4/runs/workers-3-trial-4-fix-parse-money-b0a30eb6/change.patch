@@ -1,7 +1,34 @@
 export function parseMoney(input: string): number {
-  const digits = input.replace(/[^0-9-]/g, "");
-  if (digits.length === 0 || digits === "-") {
+  if (typeof input !== "string") {
     throw new TypeError("invalid money amount");
   }
-  return Number.parseInt(digits, 10);
+  const trimmed = input.trim();
+  if (trimmed === "") {
+    throw new TypeError("invalid money amount");
+  }
+
+  const match = /^-?\$?(\d{1,3}(,\d{3})*)(\.\d+)?$/.exec(trimmed);
+  if (!match) {
+    throw new TypeError("invalid money amount");
+  }
+
+  const sign = trimmed.startsWith("-") ? -1 : 1;
+  const intPart = match[1].replace(/,/g, "");
+  const fracPart = match[3] ? match[3].slice(1) : "";
+
+  let cents = Number(intPart) * 100 + Number((fracPart + "00").slice(0, 2));
+  if (fracPart.length > 2 && Number(fracPart[2]) >= 5) {
+    cents += 1;
+  }
+  cents *= sign;
+
+  if (!Number.isFinite(cents)) {
+    throw new TypeError("invalid money amount");
+  }
+
+  const whole = Math.floor(Math.abs(cents) / 100);
+  const rem = Math.abs(cents) % 100;
+  return Number(
+    `${sign < 0 ? "-" : ""}${whole}.${String(rem).padStart(2, "0")}`,
+  );
 }
