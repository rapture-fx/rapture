\n});","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/wira/Documents/rapture/rapture-provider-runtime-attribution/experiments/opencode-runtime-attribution-3v4/exp-2026-08-22-f275370a-ec7/.worktrees/workers-3-trial-6-fix-parse-money-f068d0f3/tests/money.test.ts","text":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { parseMoney } from \"../src/money.ts\";\n\ntest(\"parses dollar and comma-formatted amounts to cents-rounded dollars\", () => {\n  assert.equal(parseMoney(\"$12.50\"), 12.5);\n  assert.equal(parseMoney(\"12.50\"), 12.5);\n  assert.equal(parseMoney(\"0.99\"), 0.99);\n  assert.equal(parseMoney(\"1,234.56\"), 1234.56);\n});\n\ntest(\"rejects empty and non-numeric input\", () => {\n  assert.throws(() => parseMoney(\"\"), TypeError);\n  assert.throws(() => parseMoney(\"abc\"), TypeError);\n});","lineStart":1,"lineEnd":15,"totalLines":15,"truncated":false}},"title":"tests/money.test.ts","time":{"start":1787361339965,"end":1787361340139}},"id":"prt_02709a6d30013Ude5MyZWiKRFF","sessionID":"ses_fd8f6e905ffeNoMSinZzMb31SK","messageID":"msg_027099abd001aIetrF5rcw7tYs"}}
