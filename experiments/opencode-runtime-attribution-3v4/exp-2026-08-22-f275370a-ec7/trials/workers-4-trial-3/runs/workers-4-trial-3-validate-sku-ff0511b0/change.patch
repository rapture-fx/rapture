diff --git a/src/sku.ts b/src/sku.ts
index e03c6a83005295d0a091f0cfe9c1ef1fa16cc796..4b94e2b04d71b74a4824db357e537474c4b428fc 100644
--- a/src/sku.ts
+++ b/src/sku.ts
@@ -1,3 +1,12 @@
 export function createSku(department: string, id: string): string {
+  if (!department || !id) {
+    throw new TypeError("department and id must not be empty");
+  }
+  if (department.length !== 3 || department !== department.toUpperCase()) {
+    throw new TypeError("department must be a 3-letter uppercase value");
+  }
+  if (id.length !== 4 || !/^\d+$/.test(id)) {
+    throw new TypeError("id must be a 4-digit value");
+  }
   return `${department}-${id}`;
 }
