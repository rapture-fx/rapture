diff --git a/src/sku.ts b/src/sku.ts
index e03c6a83005295d0a091f0cfe9c1ef1fa16cc796..e67b185e8eab3fa7aeb14e93e04a7fc1d3a46817 100644
--- a/src/sku.ts
+++ b/src/sku.ts
@@ -1,3 +1,13 @@
 export function createSku(department: string, id: string): string {
+  if (
+    department === "" ||
+    department.length !== 3 ||
+    department !== department.toUpperCase() ||
+    id === "" ||
+    id.length !== 4 ||
+    !/^\d+$/.test(id)
+  ) {
+    throw new TypeError("Invalid department or id");
+  }
   return `${department}-${id}`;
 }
