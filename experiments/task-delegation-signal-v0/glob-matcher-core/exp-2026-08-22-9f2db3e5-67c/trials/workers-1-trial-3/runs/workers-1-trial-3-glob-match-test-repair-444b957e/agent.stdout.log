tcher-core/exp-2026-08-22-9f2db3e5-67c/.worktrees/workers-1-trial-3-glob-match-test-repair-444b957e/index.js","text":"'use strict';\n\nconst pico = require('./lib/glob-match');\nconst utils = require('./lib/utils');\n\nfunction globMatch(glob, options, returnState = false) {\n  // default to os.platform()\n  if (options && (options.windows === null || options.windows === undefined)) {\n    // don't mutate the original options object\n    options = { ...options, windows: utils.isWindows() };\n  }\n\n  return pico(glob, options, returnState);\n}\n\nObject.assign(globMatch, pico);\nmodule.exports = globMatch;","lineStart":1,"lineEnd":17,"totalLines":17,"truncated":false}},"title":"index.js","time":{"start":1787404397890,"end":1787404397922}},"id":"prt_0299aa98e001HGgoZwRNkoo161","sessionID":"ses_fd665827cffemMefrWvkwCGaji","messageID":"msg_0299a9aa2001EmcHLjNP0XXidx"}}
