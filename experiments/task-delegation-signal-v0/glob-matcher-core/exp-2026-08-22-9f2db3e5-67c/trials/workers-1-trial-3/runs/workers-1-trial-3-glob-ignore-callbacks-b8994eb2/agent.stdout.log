rr a.js: true arr a.min.js: false arr b.css: true\n","exit":0,"truncated":false},"title":"node -e '\nconst g = require(\"./index.js\");\n// ignore\nconst m = g(\"*.js\", { ignore: \"*.min.js\" });\nconsole.log(\"a.js:\", m(\"a.js\"), \"a.min.js:\", m(\"a.min.js\"));\nconst r = m(\"a.min.js\", true);\nconsole.log(\"result isMatch/ignored:\", r.isMatch, r.ignored);\n\n// callbacks\nconst calls = {result:0, match:0, ignore:0};\nconst m2 = g(\"*.js\", { ignore: \"*.min.js\", onResult:()=>calls.result++, onMatch:()=>calls.match++, onIgnore:()=>calls.ignore++ });\nm2(\"a.js\"); m2(\"b.min.js\"); m2(\"c.txt\");\nconsole.log(calls);\n\n// non-matched input reported as non-match, not ignored\nconst r2 = m2(\"c.txt\", true);\nconsole.log(\"nonmatch isMatch/ignored:\", r2.isMatch, r2.ignored);\nconsole.log(\"result keys:\", Object.keys(r2).join(\",\"));\n\n// ignore array + no callback inheritance\nlet childFired = 0;\nconst m3 = g(\"*.js\", { ignore: [\"*.min.js\", \"vendor/*\"], onResult: ()=>{} });\nconsole.log(\"vendor/x.js:\", m3(\"vendor/x.js\"), \"a.js:\", m3(\"a.js\"));\n\n// array pattern\nconst m4 = g([\"*.js\",\"*.css\"], { ignore: \"*.min.js\" });\nconsole.log(\"arr a.js:\", m4(\"a.js\"), \"arr a.min.js:\", m4(\"a.min.js\"), \"arr b.css:\", m4(\"b.css\"));\n'\n","time":{"start":1787404371332,"end":1787404371338}},"id":"prt_0299a3302001magUtiwsHiY0U9","sessionID":"ses_fd667a861ffejsQ4XYeNVKrJiA","messageID":"msg_0299a1fbb001lHrhT2QrAFYrPo"}}
