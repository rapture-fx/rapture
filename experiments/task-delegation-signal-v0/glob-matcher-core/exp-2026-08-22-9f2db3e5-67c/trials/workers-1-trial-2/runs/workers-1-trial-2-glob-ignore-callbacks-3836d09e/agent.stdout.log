lt = opts.onResult;\n  const onMatch = opts.onMatch;\n  const onIgnore = opts.onIgnore;\n  const hasHooks = ignoreArg !== null || typeof onResult === 'function' || typeof onMatch === 'function' || typeof onIgnore === 'function';\n\n  if (Array.isArray(glob)) {\n    const subOpts = { ...opts };\n    delete subOpts.ignore;\n    delete subOpts.onResult;\n    delete subOpts.onMatch;\n    delete subOpts.onIgnore;\n    const fns = glob.map(input => globMatch(input, subOpts, returnState));\n    const arrayMatcher = str => {\n      for (const isMatch of fns) {\n        const state = isMatch(str);\n        if (state) return state;\n      }\n      return false;\n    };\n\n    if (!hasHooks) {\n      return arrayMatcher;\n    }\n\n    const ignoreMatcher = ignoreArg !== null ? globMatch(ignoreArg, subOpts) : null;\n\n    const matcher = (input, returnObject = false) => {\n      const base = arrayMatcher(input, true);\n      const ignored = ignoreMatcher ? Boolean(ignoreMatcher(input)) : false;\n      const finalIsMatch = Boolean(base) && !ignored;\n      const result = base\n        ? { ...base, isMatch: finalIsMatch }\n        : { glob, regex: undefined, state: undefined, posix: opts.windows, input, output: input, match: false, isMatch: false };\n\n      if (typeof onResult === 'function') onResult(result);\n      if (finalIsMatch && typeof onMatch === 'function') onMatch(result);\n      if (ignored && typeof onIgnore === 'function') onIgnore(result);\n\n      if (returnState) matcher.state = undefined;\n      return returnObject ? result : finalIsMatch;\n    };\n\n    if (returnState) matcher.state = undefined;\n    return matcher;\n  }\n\n  const isState = isObject(glob) && glob.tokens && glob.input;\n\n  if (glob === '' || (typeof glob !== 'string' && !isState)) {\n    throw new TypeError('Expected pattern to be a non-empty string');\n  }\n\n  const posix = opts.windows;\n  const regex = isState\n    ? globMatch.compileRe(glob, options)\n    : globMatch.makeRe(glob, options, false, true);\n\n  const state = regex.state;\n  delete regex.state;\n\n  const core = input => {\n    const { isMatch, match, output } = globMatch.test(input, regex, options, { glob, posix });\n    return { glob, state, regex, posix, input, output, match, isMatch };\n  };\n\n  if (!hasHooks) {\n    const matcher = (input, returnObject = false) => {\n      const result = core(input);\n      if (result.isMatch === false) {\n        return returnObject ? result : false;\n      }\n      return returnObject ? result : true;\n    };\n\n    if (returnState) matcher.state = state;\n    return matcher;\n  }\n\n  const ignoreMatcher = ignoreArg !== null\n    ? globMatch(ignoreArg, { ...opts, ignore: undefined, onResult: undefined, onMatch: undefined, onIgnore: undefined })\n    : null;\n\n  const matcher = (input, returnObject = false) => {\n    const base = core(input);\n    const ignored = ignoreMatcher ? Boolean(ignoreMatcher(input)) : false;\n    const finalIsMatch = base.isMatch === true && !ignored;\n    const result = { ...base, isMatch: finalIsMatch };\n\n    if (typeof onResult === 'function') onResult(result);\n    if (finalIsMatch && typeof onMatch === 'function') onMatch(result);\n    if (ignored && typeof onIgnore === 'function') onIgnore(result);\n\n    if (returnState) matcher.state = state;\n    return returnObject ? result : finalIsMatch;\n  };\n\n  if (returnState) matcher.state = state;\n  return matcher;\n};"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/glob-matcher-core/exp-2026-08-22-9f2db3e5-67c/.worktrees/workers-1-trial-2-glob-ignore-callbacks-3836d09e/lib/glob-match.js\n===================================================================\n--- /Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/glob-matcher-core/exp-2026-08-22-9f2db3e5-67c/.worktrees/workers-1-trial-2-glob-ig