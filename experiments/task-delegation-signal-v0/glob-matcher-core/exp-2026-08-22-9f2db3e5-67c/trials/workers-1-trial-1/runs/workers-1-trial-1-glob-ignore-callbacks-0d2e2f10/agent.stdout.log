ength, \"ignores:\", ignores.length);\nconsole.log(\"result keys a.js:\", Object.keys(results[0]).sort());\nconsole.log(\"result isMatch a.js:\", results[0].isMatch, \"foo.js:\", results[1].isMatch, \"a.txt:\", results[2].isMatch);\nconsole.log(\"foo.js ignored flag:\", results[1].ignored, \"a.txt ignored:\", results[2].ignored);\n\n// ignore must not inherit callbacks\nlet ignoreCbCalled = 0;\nconst mi = glob(\"*.js\", { ignore: \"foo.js\", onResult: () => ignoreCbCalled++ });\nmi(\"a.js\"); mi(\"foo.js\");\nconsole.log(\"top-level onResult calls:\", ignoreCbCalled);\n\n// returnObject form\nconst r = glob(\"*.js\", { ignore: \"foo.js\" })( \"a.js\", true);\nconsole.log(\"returnObject isMatch:\", r.isMatch, \"has glob/regex/input/output:\", !!r.glob, !!r.regex, !!r.input, !!r.output);\n'","time":{"start":1787403607784,"end":1787403607796}},"id":"prt_0298e7c87001tesT03h5qpc0wS","sessionID":"ses_fd673c1edffex0sbKVMV4dyj5E","messageID":"msg_0298e6eb0001aI4IG1Ns6YHq1c"}}
