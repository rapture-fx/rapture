acks or the ignore pattern: both are applied\n   * once, at the outermost level.\n   */\n  const internalOptions = { ...opts };\n  delete internalOptions.onResult;\n  delete internalOptions.onMatch;\n  delete internalOptions.onIgnore;\n  delete internalOptions.ignore;\n\n  let core;\n  let globForResult = glob;\n  let regexForResult;\n  let stateForResult;\n\n  if (Array.isArray(glob)) {\n    const fns = glob.map(input => globMatch(input, internalOptions, returnState));\n    core = str => {\n      for (const isMatch of fns) {\n        const state = isMatch(str);\n        if (state) return state;\n      }\n      return false;\n    };\n  } else {\n    const isState = isObject(glob) && glob.tokens && glob.input;\n\n    if (glob === '' || (typeof glob !== 'string' && !isState)) {\n      throw new TypeError('Expected pattern to be a non-empty string');\n    }\n\n    const posix = opts.windows;\n    const regex = isState\n      ? globMatch.compileRe(glob, options)\n      : globMatch.makeRe(glob, options, false, true);\n\n    const state = regex.state;\n    delete regex.state;\n\n    core = (input, returnObject = false) => {\n      const { isMatch, match, output } = globMatch.test(input, regex, options, { glob, posix });\n      const result = { glob, state, regex, posix, input, output, match, isMatch };\n\n      if (isMatch === false) {\n        result.isMatch = false;\n        return returnObject ? result : false;\n      }\n\n      return returnObject ? result : true;\n    };\n\n    regexForResult = regex;\n    stateForResult = state;\n  }\n\n  // No lifecycle or ignore handling requested: return the bare matcher\n  // unchanged so existing behaviour is preserved.\n  if (!opts.ignore && !opts.onResult && !opts.onMatch && !opts.onIgnore) {\n    const bare = core;\n    if (returnState && regexForResult) bare.state = stateForResult;\n    return bare;\n  }\n\n  const ignoreMatcher = opts.ignore ? globMatch(opts.ignore, internalOptions) : null;\n\n  const matcher = (input, returnObject = false) => {\n    const base = core(input, true);\n    const matched = base === true || Boolean(base && base.isMatch);\n\n    let isIgnored = false;\n    if (matched && ignoreMatcher) {\n      const ig = ignoreMatcher(input);\n      isIgnored = ig === true || Boolean(ig && ig.isMatch);\n    }\n\n    const finalIsMatch = matched && !isIgnored;\n\n    const result = isObject(base)\n      ? { ...base, isMatch: finalIsMatch, ignored: isIgnored }\n      : { glob: globForResult, regex: regexForResult, input, output: input, isMatch: finalIsMatch, ignored: isIgnored };\n\n    if (opts.onResult) opts.onResult(result);\n    if (finalIsMatch && opts.onMatch) opts.onMatch(result);\n    if (isIgnored && opts.onIgnore) opts.onIgnore(result);\n\n    if (Array.isArray(glob)) {\n      // Preserve the existing array matcher contract: always a boolean.\n      return finalIsMatch;\n    }\n\n    return returnObject ? result : finalIsMatch;\n  };\n\n  if (returnState && regexForResult) {\n    matcher.state = stateForResult;\n  }\n\n  return matcher;\n};"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/glob-matcher-core/exp-2026-08-22-9f2db3e5-67c/.worktrees/workers-1-trial-1-glob-ignore-callbacks-0d2e2f10/lib/glob-match.js\n===================================================================\n--- /Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/glob-matcher-core/exp-2026-08-22-9f2db3e5-67c/.worktrees/workers-1-trial-1-glob-ignore-callbacks-0d2e2f10/lib/glob-match.js\n+++ /Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/glob-matcher-core/exp-2026-08-22-9f2db3e5-67c/.worktrees/workers-1-trial-1-glob-ignore-callbacks-0d2e2f10/lib/glob-match.js\n@@ -39,49 +39,106 @@\n  * @api public\n  */\n \n const globMatch = (glob, options, returnState = false) => {\n+  const o