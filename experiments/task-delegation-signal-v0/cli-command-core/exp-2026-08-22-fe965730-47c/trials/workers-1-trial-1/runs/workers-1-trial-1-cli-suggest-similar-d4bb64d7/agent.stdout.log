{"type":"tool_use","timestamp":1787404869832,"sessionID":"ses_fd65fb037ffezigwZlQUww192u","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-10793c60ff8f40a1ac8056aa9f898df0","state":{"status":"completed","input":{"content":"const maxDistance = 3;\n\n/**\n * Damerau-Levenshtein (optimal string alignment) edit distance.\n * A transposition of two adjacent characters counts as a single edit.\n *\n * @param {string} a\n * @param {string} b\n * @returns {number}\n */\nfunction editDistance(a, b) {\n  const lenA = a.length;\n  const lenB = b.length;\n  if (lenA === 0) return lenB;\n  if (lenB === 0) return lenA;\n\n  const da = Object.create(null);\n  const d = [];\n  for (let i = 0; i <= lenA; i++) {\n    d[i] = new Array(lenB + 1).fill(0);\n  }\n  for (let i = 0; i <= lenA; i++) d[i][0] = i;\n  for (let j = 0; j <= lenB; j++) d[0][j] = j;\n\n  for (let i = 1; i <= lenA; i++) {\n    let db = 0;\n    for (let j = 1; j <= lenB; j++) {\n      const k = da[b.charAt(j - 1)] || 0;\n      const l = db;\n      const cost = a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1;\n      if (cost === 0) db = j;\n\n      const substitution = d[i - 1][j - 1] + cost;\n      const insertion = d[i][j - 1] + 1;\n      const deletion = d[i - 1][j] + 1;\n      let transposition = substitution + 1;\n      if (k > 0 && l > 0) {\n        transposition = d[k - 1][l - 1] + (i - k - 1) + 1 + (j - l - 1);\n      }\n      d[i][j] = Math.min(substitution, insertion, deletion, transposition);\n    }\n    da[a.charAt(i - 1)] = i;\n  }\n  return d[lenA][lenB];\n}\n\n/**\n * Find close matches for a mistyped word among a list of candidates.\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n  const normalizedWord = searchingOptions ? word.replace(/^-+/, '') : word;\n\n  let best = { distance: Number.MAX_SAFE_INTEGER, matches: [] };\n\n  for (const candidate of candidates) {\n    const normalizedCandidate = searchingOptions ? candidate.replace(/^-+/, '') : candidate;\n    if (normalizedCandidate.length <= 1) continue;\n\n    const distance = editDistance(normalizedWord, normalizedCandidate);\n    if (distance > maxDistance) continue;\n\n    const longer = Math.max(normalizedWord.length, normalizedCandidate.length);\n    const similarity = (longer - distance) / longer;\n    if (similarity <= 0.4) continue;\n\n    if (distance < best.distance) {\n      best = { distance, matches: [normalizedCandidate] };\n    } else if (distance === best.distance) {\n      best.matches.push(normalizedCandidate);\n    }\n  }\n\n  if (best.matches.length === 0) return '';\n\n  const seen = new Set();\n  const suggestions = [];\n  for (const match of best.matches) {\n    if (seen.has(match)) continue;\n    seen.add(match);\n    suggestions.push(searchingOptions ? `--${match}` : match);\n  }\n  suggestions.sort((a, b) => a.localeCompare(b));\n\n  if (suggestions.length === 1) {\n    return `\\n(Did you mean ${suggestions[0]}?)`;\n  }\n  return `\\n(Did you mean one of ${suggestions.join(', ')}?)`;\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/cli-command-core/exp-2026-08-22-fe965730-47c/.worktrees/workers-1-trial-1-cli-suggest-similar-d4bb64d7/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/cli-command-core/exp-2026-08-22-fe965730-47c/.worktrees/workers-1-trial-1-cli-suggest-similar-d4bb64d7/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787404869811,"end":1787404869830}},"id":"prt_029a1b2b0001L5uackB06ydV7h","sessionID":"ses_fd65fb037ffezigwZlQUww192u","messageID":"msg_029a0c700001xUJ87EZ781mYbZ"}}
