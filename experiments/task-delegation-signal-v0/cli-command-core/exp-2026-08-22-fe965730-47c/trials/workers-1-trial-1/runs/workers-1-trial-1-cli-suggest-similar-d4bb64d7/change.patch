 /**
- * Find close matches, restricted to same number of edits.
+ * Damerau-Levenshtein (optimal string alignment) edit distance.
+ * A transposition of two adjacent characters counts as a single edit.
+ *
+ * @param {string} a
+ * @param {string} b
+ * @returns {number}
+ */
+function editDistance(a, b) {
+  const lenA = a.length;
+  const lenB = b.length;
+  if (lenA === 0) return lenB;
+  if (lenB === 0) return lenA;
+
+  const da = Object.create(null);
+  const d = [];
+  for (let i = 0; i <= lenA; i++) {
+    d[i] = new Array(lenB + 1).fill(0);
+  }
+  for (let i = 0; i <= lenA; i++) d[i][0] = i;
+  for (let j = 0; j <= lenB; j++) d[0][j] = j;
+
+  for (let i = 1; i <= lenA; i++) {
+    let db = 0;
+    for (let j = 1; j <= lenB; j++) {
+      const k = da[b.charAt(j - 1)] || 0;
+      const l = db;
+      const cost = a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1;
+      if (cost === 0) db = j;
+
+      const substitution = d[i - 1][j - 1] + cost;
+      const insertion = d[i][j - 1] + 1;
+      const deletion = d[i - 1][j] + 1;
+      let transposition = substitution + 1;
+      if (k > 0 && l > 0) {
+        transposition = d[k - 1][l - 1] + (i - k - 1) + 1 + (j - l - 1);
+      }
+      d[i][j] = Math.min(substitution, insertion, deletion, transposition);
+    }
+    da[a.charAt(i - 1)] = i;
+  }
+  return d[lenA][lenB];
+}
