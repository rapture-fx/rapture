nly allow argument value to be one of choices.\n   *\n   * @param {string[]} values\n   * @return {Argument}\n   */\n\n  choices(values) {\n    this.argChoices = values;\n    return this;\n  }\n\n  /**\n   * Make argument required.\n   *\n   * @returns {Argument}\n   */\n  argRequired() {\n    this.required = true;\n    return this;\n  }\n\n  /**\n   * Make argument optional.\n   *\n   * @returns {Argument}\n   */\n  argOptional() {\n    this.required = false;\n    return this;\n  }\n}\n\n/**\n * Takes an argument and returns its human readable equivalent for help usage.\n *\n * @param {Argument} arg\n * @return {string}\n * @private\n */\n\nexport function humanReadableArgName(arg) {\n  const nameOutput = arg.name() + (arg.variadic === true ? '...' : '');\n\n  return arg.required ? '<' + nameOutput + '>' : '[' + nameOutput + ']';\n}","lineStart":1,"lineEnd":112,"totalLines":112,"truncated":false}},"title":"lib/argument.js","time":{"start":1787404545298,"end":1787404545326}},"id":"prt_0299ce93d0019TC4SajlJOTSCg","sessionID":"ses_fd6632c65ffeSwbAWOQblulhGT","messageID":"msg_0299cd649001Q4UkMuV8O3XD08"}}
