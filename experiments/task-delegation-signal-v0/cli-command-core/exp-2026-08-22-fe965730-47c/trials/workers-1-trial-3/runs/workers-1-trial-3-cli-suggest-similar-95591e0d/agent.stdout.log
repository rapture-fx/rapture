{"type":"tool_use","timestamp":1787405434679,"sessionID":"ses_fd655fa2fffe4sezgyClW9MTZ4","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-bb1f1f4f55e36224","state":{"status":"completed","input":{"content":"const maxDistance = 3;\n\n/**\n * Find close matches, restricted to same number of edits.\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\n\nfunction editDistance(a, b) {\n  const alen = a.length;\n  const blen = b.length;\n  const dp = [];\n  for (let i = 0; i <= alen; i++) {\n    dp.push(new Array(blen + 1).fill(0));\n  }\n  for (let i = 0; i <= alen; i++) dp[i][0] = i;\n  for (let j = 0; j <= blen; j++) dp[0][j] = j;\n\n  for (let i = 1; i <= alen; i++) {\n    for (let j = 1; j <= blen; j++) {\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      dp[i][j] = Math.min(\n        dp[i - 1][j] + 1,\n        dp[i][j - 1] + 1,\n        dp[i - 1][j - 1] + cost,\n      );\n      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {\n        dp[i][j] = Math.min(dp[i][j], dp[i - 2][j - 2] + 1);\n      }\n    }\n  }\n  return dp[alen][blen];\n}\n\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n  const strippedWord = searchingOptions ? word.replace(/^-+/, '') : word;\n\n  let best = { distance: Number.POSITIVE_INFINITY, matches: [] };\n\n  for (const candidate of candidates) {\n    if (!candidate || candidate.length <= 1) continue;\n\n    const strippedCandidate = searchingOptions\n      ? candidate.replace(/^-+/, '')\n      : candidate;\n    if (strippedCandidate.length <= 1) continue;\n\n    const longer = Math.max(strippedWord.length, strippedCandidate.length);\n    const distance = editDistance(strippedWord, strippedCandidate);\n    if (distance > maxDistance) continue;\n\n    const similarity = (longer - distance) / longer;\n    if (similarity <= 0.4) continue;\n\n    if (distance < best.distance) {\n      best = { distance, matches: [candidate] };\n    } else if (distance === best.distance) {\n      best.matches.push(candidate);\n    }\n  }\n\n  if (best.matches.length === 0) return '';\n\n  const suggestions = [...new Set(best.matches)].sort((a, b) =>\n    a.localeCompare(b),\n  );\n\n  if (suggestions.length === 1) {\n    return `\\n(Did you mean ${suggestions[0]}?)`;\n  }\n  return `\\n(Did you mean one of ${suggestions.join(', ')}?)`;\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/cli-command-core/exp-2026-08-22-fe965730-47c/.worktrees/workers-1-trial-3-cli-suggest-similar-95591e0d/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/cli-command-core/exp-2026-08-22-fe965730-47c/.worktrees/workers-1-trial-3-cli-suggest-similar-95591e0d/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787405434645,"end":1787405434669}},"id":"prt_029aa6968001F1J1yT7c3t6Qzx","sessionID":"ses_fd655fa2fffe4sezgyClW9MTZ4","messageID":"msg_029aa582b00190nYD87AfWw9pV"}}
