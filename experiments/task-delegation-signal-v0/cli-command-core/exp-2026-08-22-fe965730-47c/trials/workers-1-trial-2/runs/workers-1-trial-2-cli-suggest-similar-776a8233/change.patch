+function damerauLevenshtein(a, b, limit) {
+  if (a.length === 0) return b.length;
+  if (b.length === 0) return a.length;
+
+  const matrix = [];
+
+  for (let i = 0; i <= a.length; i++) {
+    matrix[i] = [i];
+  }
+
+  for (let j = 0; j <= b.length; j++) {
+    matrix[0][j] = j;
+  }
+
+  for (let i = 1; i <= a.length; i++) {
+    let rowMin = Infinity;
+
+    for (let j = 1; j <= b.length; j++) {
+      if (a.charAt(i - 1) === b.charAt(j - 1)) {
+        matrix[i][j] = matrix[i - 1][j - 1];
+      } else {
+        const del = matrix[i - 1][j] + 1;
+        const ins = matrix[i][j - 1] + 1;
+        const sub = matrix[i - 1][j - 1] + 1;
+        matrix[i][j] = Math.min(del, ins, sub);
+      }
+
+      if (
+        i > 1 &&
+        j > 1 &&
+        a.charAt(i - 1) === b.charAt(j - 2) &&
+        a.charAt(i - 2) === b.charAt(j - 1)
+      ) {
+        matrix[i][j] = Math.min(matrix[i][j], matrix[i - 2][j - 2] + 1);
+      }
+
+      if (matrix[i][j] < rowMin) rowMin = matrix[i][j];
+    }
+
+    if (rowMin > limit) return rowMin;
+  }
+
+  return matrix[a.length][b.length];
+}
