{"type":"tool_use","timestamp":1787405299546,"sessionID":"ses_fd658c23dffegerYj4lSOw6eEX","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-15f32b995edb42c5a8b19aead65ae239","state":{"status":"completed","input":{"content":"const maxDistance = 3;\n\n/**\n * Find close matches, restricted to the closest candidates within a small edit\n * distance.\n *\n * @param {string} word\n * @param {string[]} candidates\n * @returns {string}\n */\n\nfunction damerauLevenshtein(a, b, limit) {\n  if (a.length === 0) return b.length;\n  if (b.length === 0) return a.length;\n\n  const matrix = [];\n\n  for (let i = 0; i <= a.length; i++) {\n    matrix[i] = [i];\n  }\n\n  for (let j = 0; j <= b.length; j++) {\n    matrix[0][j] = j;\n  }\n\n  for (let i = 1; i <= a.length; i++) {\n    let rowMin = Infinity;\n\n    for (let j = 1; j <= b.length; j++) {\n      if (a.charAt(i - 1) === b.charAt(j - 1)) {\n        matrix[i][j] = matrix[i - 1][j - 1];\n      } else {\n        const del = matrix[i - 1][j] + 1;\n        const ins = matrix[i][j - 1] + 1;\n        const sub = matrix[i - 1][j - 1] + 1;\n        matrix[i][j] = Math.min(del, ins, sub);\n      }\n\n      if (\n        i > 1 &&\n        j > 1 &&\n        a.charAt(i - 1) === b.charAt(j - 2) &&\n        a.charAt(i - 2) === b.charAt(j - 1)\n      ) {\n        matrix[i][j] = Math.min(matrix[i][j], matrix[i - 2][j - 2] + 1);\n      }\n\n      if (matrix[i][j] < rowMin) rowMin = matrix[i][j];\n    }\n\n    if (rowMin > limit) return rowMin;\n  }\n\n  return matrix[a.length][b.length];\n}\n\nexport function suggestSimilar(word, candidates) {\n  if (!candidates || candidates.length === 0) return '';\n\n  const searchingOptions = word.startsWith('--');\n\n  if (searchingOptions) {\n    word = word.slice(2);\n    candidates = candidates.map((candidate) => candidate.slice(2));\n  }\n\n  const seen = new Set();\n  candidates = candidates.filter((candidate) => {\n    if (seen.has(candidate)) return false;\n    seen.add(candidate);\n    return true;\n  });\n\n  let bestDistance = Infinity;\n  const matches = [];\n\n  for (const candidate of candidates) {\n    if (candidate.length <= 1) continue;\n\n    const distance = damerauLevenshtein(\n      word,\n      candidate,\n      Math.min(bestDistance, maxDistance)\n    );\n\n    if (distance > maxDistance) continue;\n\n    const longest = Math.max(word.length, candidate.length);\n    const similarity = (longest - distance) / longest;\n\n    if (similarity <= 0.4) continue;\n\n    if (distance < bestDistance) {\n      bestDistance = distance;\n      matches.length = 0;\n      matches.push(candidate);\n    } else if (distance === bestDistance) {\n      matches.push(candidate);\n    }\n  }\n\n  if (searchingOptions) {\n    matches.forEach((match, index) => {\n      matches[index] = `--${match}`;\n    });\n    word = `--${word}`;\n  }\n\n  matches.sort((a, b) => a.localeCompare(b));\n\n  if (matches.length === 1) {\n    return `\\n(Did you mean ${matches[0]}?)`;\n  }\n  if (matches.length > 1) {\n    return `\\n(Did you mean one of ${matches.join(', ')}?)`;\n  }\n  return '';\n}\n","filePath":"/Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/cli-command-core/exp-2026-08-22-fe965730-47c/.worktrees/workers-1-trial-2-cli-suggest-similar-776a8233/lib/suggestSimilar.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/cli-command-core/exp-2026-08-22-fe965730-47c/.worktrees/workers-1-trial-2-cli-suggest-similar-776a8233/lib/suggestSimilar.js","exists":true,"truncated":false},"title":"lib/suggestSimilar.js","time":{"start":1787405299528,"end":1787405299544}},"id":"prt_029a84a4b001ykURrDlfGBanNV","sessionID":"ses_fd658c23dffegerYj4lSOw6eEX","messageID":"msg_029a83dee001wLfr4zIZ1d8eE0"}}
