: });\n34: \n35: test('defaults apply only when the option is absent', () => {\n36:   assert.deepEqual(parse((c) => c.option('-p, --port <n>', 'port', '8080'), []), {\n37:     port: '8080',\n38:   });\n39:   assert.deepEqual(parse((c) => c.option('-p, --port <n>', 'port', '8080'), ['-p', '99']), {\n40:     port: '99',\n41:   });\n42: });\n43: \n44: test('long flag names are camelcased into attribute names', () => {\n45:   assert.equal(new Option('--check-updates').attributeName(), 'checkUpdates');\n46:   assert.equal(new Option('-v, --verbose').attributeName(), 'verbose');\n47:   assert.equal(new Option('--dry-run-only').attributeName(), 'dry-run-only');\n48:   assert.deepEqual(parse((c) => c.option('--check-updates', 'check'), ['--check-updates']), {\n49:     checkUpdates: true,\n50:   });\n51: });\n52: \n53: test('option kind is reported correctly', () => {\n54:   assert.equal(new Option('-v, --verbose').isBoolean(), true);\n55:   assert.equal(new Option('-n, --number <n>').isBoolean(), true);\n56:   assert.equal(new Option('-n, --number [n]').isBoolean(), false);\n57:   assert.equal(new Option('-n, --number <n>').required, true);\n58:   assert.equal(new Option('-n, --number [n]').optional, true);\n59:   assert.equal(new Option('-v, --verbose').required, false);\n60: });\n61: \n62: test('an option recognises only its own flags', () => {\n63:   const option = new Option('-n, --number <n>');\n64:   assert.equal(option.is('-n'), true);\n65:   assert.equal(option.is('--number'), true);\n66:   assert.equal(option.is('-x'), true);\n67:   assert.equal(option.is('--other'), false);\n68:   assert.equal(new Option('--long-only').is('--long-only'), true);\n69:   assert.equal(new Option('--long-only').is('-l'), false);\n70: });\n71: \n72: test('flags are split into short and long forms', () => {\n73:   const both = new Option('-n, --number <n>');\n74:   assert.equal(both.short, '-n');\n75:   assert.equal(both.long, '--number');\n76:   assert.equal(both.name(), 'number');\n77: