===\"2.3.4\" ? \"PASS\":\"FAIL\")\n// prerelease check\nconst pr = coerce(\"1.2.3-alpha.1+build.2\",{includePrerelease:true})\nconsole.log(\"prerelease:\", JSON.stringify(pr.prerelease), \"build:\", JSON.stringify(pr.build))\nprocess.exit(ok?0:1)\n'","time":{"start":1787402773261,"end":1787402773275}},"id":"prt_02981d06b001ZO3ggiTMXkg0XN","sessionID":"ses_fd67fe98cffey1I2qfocHFic9y","messageID":"msg_02981c2ce001xLGuqoa4lt7x70"}}
