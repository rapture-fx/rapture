l) {\n    return null\n  }\n\n  const major = match[2]\n  const minor = match[3] || '0'\n  const patch = match[4] || '0'\n  const prerelease = options.includePrerelease && match[5] ? `-${match[5]}` : ''\n  const build = options.includePrerelease && match[6] ? `+${match[6]}` : ''\n\n  return parse(`${major}.${minor}.${patch}${prerelease}${build}`, options)\n}\nmodule.exports = coerce\n","metadata":{"truncated":false},"title":"https://raw.githubusercontent.com/npm/node-semver/main/functions/coerce.js (text/plain; charset=utf-8)","time":{"start":1787402116617,"end":1787402117373}},"id":"prt_02977dcbf0014IdNqiGmZ7SzEQ","sessionID":"ses_fd6898d22ffejhqVAZAhCaZVGe","messageID":"msg_0297692a8001vV9wy0L7f7xqqB"}}
