{"type":"tool_use","timestamp":1787402285064,"sessionID":"ses_fd6877088ffeqAg0iJcT4UXQ3x","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-972e8d0a29104f73967408534aeb1205","state":{"status":"completed","input":{"content":"'use strict'\n\nconst parse = require('./parse.js')\n\nconst diff = (version1, version2) => {\n  const v1 = parse(version1, null, true)\n  const v2 = parse(version2, null, true)\n  const comparison = v1.compare(v2)\n\n  if (comparison === 0) {\n    return null\n  }\n\n  const v1Higher = comparison > 0\n  const highVersion = v1Higher ? v1 : v2\n  const lowVersion = v1Higher ? v2 : v1\n  const highHasPre = !!highVersion.prerelease.length\n  const lowHasPre = !!lowVersion.prerelease.length\n\n  // stepping OUT of a prerelease: the higher version is a release while the\n  // lower version is a prerelease.\n  if (!highHasPre && lowHasPre) {\n    if (highVersion.major !== lowVersion.major) {\n      return 'major'\n    }\n    if (highVersion.minor !== lowVersion.minor) {\n      return 'minor'\n    }\n    if (highVersion.patch !== lowVersion.patch) {\n      return 'patch'\n    }\n    // the main version is unchanged: classify by how much is left behind\n    if (lowVersion.minor === 0 && lowVersion.patch === 0) {\n      return 'major'\n    }\n    if (lowVersion.minor !== 0 && lowVersion.patch === 0) {\n      return 'minor'\n    }\n    return 'patch'\n  }\n\n  // add the `pre` prefix when moving to/within a prerelease version\n  const prefix = highHasPre ? 'pre' : ''\n\n  // two prereleases of the same main version, or with a differing main version\n  if (highHasPre && lowHasPre) {\n    if (highVersion.major !== lowVersion.major) {\n      return 'major'\n    }\n    if (highVersion.minor !== lowVersion.minor) {\n      return 'minor'\n    }\n    if (highVersion.patch !== lowVersion.patch) {\n      return 'patch'\n    }\n    return 'prerelease'\n  }\n\n  // ordinary release step, or stepping INTO a prerelease\n  if (highVersion.major !== lowVersion.major) {\n    return prefix + 'major'\n  }\n  if (highVersion.minor !== lowVersion.minor) {\n    return prefix + 'minor'\n  }\n  if (highVersion.patch !== lowVersion.patch) {\n    return prefix + 'patch'\n  }\n\n  // high is a prerelease, low is a release, and the main version is unchanged\n  return 'prerelease'\n}\n\nmodule.exports = diff\n","filePath":"/Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/version-core/exp-2026-08-22-dd63b975-0b1/.worktrees/workers-1-trial-2-version-diff-release-type-95769641/functions/diff.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-task-delegation-v0/experiments/task-delegation-signal-v0/version-core/exp-2026-08-22-dd63b975-0b1/.worktrees/workers-1-trial-2-version-diff-release-type-95769641/functions/diff.js","exists":true,"truncated":false},"title":"functions/diff.js","time":{"start":1787402285043,"end":1787402285062}},"id":"prt_0297a6079001LCJOan5ScXxVSV","sessionID":"ses_fd6877088ffeqAg0iJcT4UXQ3x","messageID":"msg_0297a28fe0017VCHjqJGQUn4lI"}}
