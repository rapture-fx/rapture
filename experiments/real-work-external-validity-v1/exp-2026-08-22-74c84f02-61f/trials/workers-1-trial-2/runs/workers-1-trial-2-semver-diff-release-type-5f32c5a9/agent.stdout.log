{"type":"tool_use","timestamp":1787389926952,"sessionID":"ses_fd7443316ffeARpH9lvDcf8w5e","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-ae33b13dccb90402","state":{"status":"completed","input":{"content":"'use strict'\n\nconst parse = require('./parse.js')\n\nconst diff = (version1, version2) => {\n  const v1 = parse(version1, null, true)\n  const v2 = parse(version2, null, true)\n  const comparison = v1.compare(v2)\n\n  if (comparison === 0) {\n    return null\n  }\n\n  const v1Higher = comparison > 0\n  const high = v1Higher ? v1 : v2\n  const low = v1Higher ? v2 : v1\n\n  const highHasPre = !!high.prerelease.length\n  const lowHasPre = !!low.prerelease.length\n\n  const mainDiffers = high.compareMain(low) !== 0\n\n  if (!mainDiffers) {\n    // the main versions are the same\n    if (highHasPre && lowHasPre) {\n      return 'prerelease'\n    }\n\n    // one version is a prerelease of the other's main version (a step out of\n    // a prerelease, which is always the lower of the two); classify by how\n    // much of the main version is being left behind.\n    if (high.minor === 0 && high.patch === 0) {\n      return 'major'\n    }\n    if (high.minor !== 0 && high.patch === 0) {\n      return 'minor'\n    }\n    return 'patch'\n  }\n\n  // the main versions differ; a step into a prerelease keeps the 'pre' prefix.\n  const prefix = highHasPre ? 'pre' : ''\n  if (high.major !== low.major) {\n    return prefix + 'major'\n  }\n  if (high.minor !== low.minor) {\n    return prefix + 'minor'\n  }\n  return prefix + 'patch'\n}\n\nmodule.exports = diff\n","filePath":"/Users/wira/Documents/rapture/rapture-real-work-v1/experiments/real-work-external-validity-v1/exp-2026-08-22-74c84f02-61f/.worktrees/workers-1-trial-2-semver-diff-release-type-5f32c5a9/functions/diff.js"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/wira/Documents/rapture/rapture-real-work-v1/experiments/real-work-external-validity-v1/exp-2026-08-22-74c84f02-61f/.worktrees/workers-1-trial-2-semver-diff-release-type-5f32c5a9/functions/diff.js","exists":true,"truncated":false},"title":"functions/diff.js","time":{"start":1787389926935,"end":1787389926950}},"id":"prt_028bdd746001WlTiQhMqQLMNd8","sessionID":"ses_fd7443316ffeARpH9lvDcf8w5e","messageID":"msg_028bd861f001qfl8YMjPX8PG8Q"}}
