{"type":"tool_use","timestamp":1787390413980,"sessionID":"ses_fd73c661fffe8OPLiTJRLfcxhw","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-eb7c40b9383b4d84a801fe36525576d4","state":{"status":"completed","input":{"content":"'use strict'\n\nconst parse = require('./parse.js')\n\nconst mainType = (v1, v2) => {\n  if (v1.major !== v2.major) {\n    return 'major'\n  }\n  if (v1.minor !== v2.minor) {\n    return 'minor'\n  }\n  if (v1.patch !== v2.patch) {\n    return 'patch'\n  }\n  return null\n}\n\nconst diff = (version1, version2) => {\n  const v1 = parse(version1, null, true)\n  const v2 = parse(version2, null, true)\n\n  const comparison = v1.compare(v2)\n\n  if (comparison === 0) {\n    return null\n  }\n\n  // Always treat the lower-precedence version as the starting point, so the\n  // result does not depend on argument order.\n  const low = comparison > 0 ? v1 : v2\n  const high = comparison > 0 ? v2 : v1\n\n  const lowHasPre = !!low.prerelease.length\n  const highHasPre = !!high.prerelease.length\n\n  const type = mainType(v1, v2)\n\n  // Two prereleases of the same main version.\n  if (lowHasPre && highHasPre) {\n    return type === null ? 'prerelease' : 'pre' + type\n  }\n\n  // Stepping out of a prerelease: the higher version is a plain release and\n  // the lower version is a prerelease.\n  if (lowHasPre && !highHasPre) {\n    if (type === null) {\n      // The main version is unchanged, so classify by what is being left behind.\n      if (low.minor === 0 && low.patch === 0) {\n        return 'major'\n      }\n      if (low.minor !== 0 && low.patch === 0) {\n        return 'minor'\n      }\n      return 'patch'\n    }\n    return type\n  }\n\n  // Stepping into a prerelease: the higher version is a prerelease.\n  if (!lowHasPre && highHasPre) {\n    return 'pre' + (type === null ? 'patch' : type)\n  }\n\n  // Ordinary release step.\n  return type\n}\n\nmodule.exports = diff\n","filePath":"/Users/wira/Documents/rapture/rapture-real-work-v1/experi