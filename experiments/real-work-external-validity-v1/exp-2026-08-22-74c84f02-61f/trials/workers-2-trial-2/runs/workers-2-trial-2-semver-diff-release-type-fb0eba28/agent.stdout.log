{"type":"tool_use","timestamp":1787390156913,"sessionID":"ses_fd73fc0ffffeGHcMl0DsijAuqm","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-6a97c0ca6f894f65b4266c13a4dd31e1","state":{"status":"completed","input":{"content":"'use strict'\n\nconst parse = require('./parse.js')\n\nconst diff = (version1, version2) => {\n  const v1 = parse(version1, null, true)\n  const v2 = parse(version2, null, true)\n  const comparison = v1.compare(v2)\n\n  if (comparison === 0) {\n    return null\n  }\n\n  const v1Higher = comparison > 0\n  const high = v1Higher ? v1 : v2\n  const low = v1Higher ? v2 : v1\n  const highHasPre = !!high.prerelease.length\n  const lowHasPre = !!low.prerelease.length\n\n  // Determine the release type from the main version differences, independent\n  // of argument order (we always look at the higher vs lower version).\n  let type\n  if (high.major !== low.major) {\n    type = 'major'\n  } else if (high.minor !== low.minor) {\n    type = 'minor'\n  } else if (high.patch !== low.patch) {\n    type = 'patch'\n  } else if (highHasPre || lowHasPre) {\n    // main versions are identical; this is a prerelease-only change\n    if (!lowHasPre) {\n      // stepping into a prerelease\n      return 'prerelease'\n    }\n    if (!highHasPre) {\n      // stepping out of a prerelease\n      if (low.minor === 0 && low.patch === 0) {\n        return 'major'\n      } else if (low.minor !== 0 && low.patch === 0) {\n        return 'minor'\n      }\n      return 'patch'\n    }\n    // both are prereleases of the same main version\n    return 'prerelease'\n  } else {\n    // identical precedence but comparison was not 0 (should not happen)\n    return null\n  }\n\n  // add the `pre` prefix when stepping into a prerelease\n  return (highHasPre ? 'pre' : '') + type\n}\n\nmodule.exports = diff\n","filePath":"/Users/wira/Documents/rapture/rapture-real-work-v1/experiments/real-work-external-validity-v1/exp-2026-08-22-74c84f02-61f/.worktrees/workers-2-trial-2-semver-diff