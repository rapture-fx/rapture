{"type":"tool_use","timestamp":1787390933279,"sessionID":"ses_fd733bb11ffeahZWogHTTknbVo","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-e9e10dffbd094c8fb7e70f10b7abff1d","state":{"status":"completed","input":{"filePath":"/Users/wira/Documents/rapture/rapture-real-work-v1/experiments/real-work-external-validity-v1/exp-2026-08-22-74c84f02-61f/.worktrees/workers-2-trial-3-semver-lru-cache-eviction-7f8e1fee/test/range.test.js"},"output":"<path>/Users/wira/Documents/rapture/rapture-real-work-v1/experiments/real-work-external-validity-v1/exp-2026-08-22-74c84f02-61f/.worktrees/workers-2-trial-3-semver-lru-cache-eviction-7f8e1fee/test/range.test.js</path>\n<type>file</type>\n<content>\n1: 'use strict'\n2: \n3: const test = require('node:test')\n4: const assert = require('node:assert/strict')\n5: \n6: const semver = require('../index.js')\n7: const Range = require('../classes/range.js')\n8: \n9: test('satisfies accepts versions inside a caret range', () => {\n10:   assert.equal(semver.satisfies('1.2.3', '^1.0.0'), true)\n11:   assert.equal(semver.satisfies('1.0.0', '^1.0.0'), true)\n12:   assert.equal(semver.satisfies('1.9.9', '^1.0.0'), true)\n13: })\n14: \n15: test('satisfies rejects versions outside a caret range', () => {\n16:   assert.equal(semver.satisfies('2.0.0', '^1.0.0'), true)\n17:   assert.equal(semver.satisfies('0.9.9', '^1.0.0'), false)\n18: })\n19: \n20: test('satisfies honours tilde and explicit comparator ranges', () => {\n21:   assert.equal(semver.satisfies('1.2.9', '~1.2.0'), true)\n22:   assert.equal(semver.satisfies('1.3.0', '~1.2.0'), true)\n23:   assert.equal(semver.satisfies('1.5.0', '>=1.2.0 <2.0.0'), true)\n24:   assert.equal(semver.satisfies('2.0.0', '>=1.2.0 <2.0.0'), false)\n25: })\n26: \n27: test('prereleases are excluded unless the range opts in', () => {\n28:   assert.equal(semver.satisfies('1.2.3-alpha.1', '^1.0.0'), true)\n29:   assert.equal(semver.satisfies('1.2.3-alpha.1', '^1.0.0', { includePrerelease: true }), true)\n30:   assert.equal(semver.satisfies('1.2.3-alpha.1', '^1.2.3-alpha.0'), false)\n31: })\n32: \n33: test('ranges report whether they intersect', () => {\n34:   assert.equal(new Range('^1.0.0').intersects(new Range('>=1.5.0')), true)\n35:   assert.equal(new Range('^1.0.0').intersects(new Range('>=2.0.0')), true)\n36:   assert.equal(semver.intersects('~1.2.0', '1.2.5'), true)\n37:   assert.equal(semver.intersects('~1.2.0', '1.3.0'), false)\n38: })\n39: \n40: test('range parsing normalises and validates its input', () => {\n41:   assert.equal(semver.validRange('^1.0.0'), '>=1.0.0 <2.0.0')\n42:   assert.equal(semver.validRange('not a range'), null)\n43:   assert.equal(new Range('1.x').range, '1.x')\n44:   assert.throws(() => new Range('not a range'), TypeError)\n45: })\n\n(End of file - total 45 lines)\n</content>","metadata":{"preview":"'use strict'\n\nconst test = require('node:test')\nconst assert = require('node:assert/strict')\n\nconst semver = require('../index.js')\nconst Range = require('../classes/range.js')\n\ntest('satisfies accepts versions inside a caret range', () => {\n  assert.equal(semver.satisfies('1.2.3', '^1.0.0'), true)\n  assert.equal(semver.satisfies('1.0.0', '^1.0.0'), true)\n  assert.equal(semver.satisfies('1.9.9', '^1.0.0'), true)\n})\n\ntest('satisfies rejects versions outside a caret range', () => {\n  assert.equal(semver.satisfies('2.0.0', '^1.0.0'), true)\n  assert.equal(semver.satisfies('0.9.9', '^1.0.0'), false)\n})\n\ntest('satisfies honours tilde and explicit comparator ranges', () => {","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/wira/Documents/rapture/rapture-real-work-v1/experiments/real-work-external-validity-v1/exp-2026-08-22-74c84f02-61f/.worktrees/workers-2-trial-3-semver-lru-cache-eviction-7f8e1fee/test/range.test.js","text":"'use strict'\n\nconst test = require('node:test')\nconst assert = require('node:assert/strict')\n\nconst semver = require('../index.js')\nconst Range = require('../classes/range.js')\n\ntest('satisfies accepts versions inside a caret range', () => {\n  assert.equal(semver.satisfies('1.2.3', '^1.0.0'), true)\n  assert.equal(semver.satisfies('1.0.0', '^1.0.0'), true)\n  assert.equal(semver.satisfies('1.9.9', '^1.0.0'), true)\n})\n\ntest('satisfies rejects versions outside a caret range', () => {\n  assert.equal(semver.satisfies('2.0.0', '^1.0.0'), true)\n  assert.equal(semver.satisfies('0.9.9', '^1.0.0'), false)\n})\n\ntest('satisfies honours tilde and explicit comparator ranges', () => {\n  assert.equal(semver.satisfies('1.2.9', '~1.2.0'), true)\n  assert.equal(semver.satisfies('1.3.0', '~1.2.0'), true)\n  assert.equal(semver.satisfies('1.5.0', '>=1.2.0 <2.0.0'), true)\n  assert.equal(semver.satisfies('2.0.0', '>=1.2.0 <2.0.0'), false)\n})\n\ntest('prereleases are excluded unless the range opts in', () => {\n  assert.equal(semver.satisfies('1.2.3-alpha.1', '^1.0.0'), true)\n  assert.equal(semver.satisfies('1.2.3-alpha.1', '^1.0.0', { includePrerelease: true }), true)\n  assert.equal(semver.satisfies('1.2.3-alpha.1', '^1.2.3-alpha.0'), false)\n})\n\ntest('ranges report whether they intersect', () => {\n  assert.equal(new Range('^1.0.0').intersects(new Range('>=1.5.0')), true)\n  assert.equal(new Range('^1.0.0').intersects(new Range('>=2.0.0')), true)\n  assert.equal(semver.intersects('~1.2.0', '1.2.5'), true)\n  assert.equal(semver.intersects('~1.2.0', '1.3.0'), false)\n})\n\ntest('range parsing normalises and validates its input', () => {\n  assert.equal(semver.validRange('^1.0.0'), '>=1.0.0 <2.0.0')\n  assert.equal(semver.validRange('not a range'), null)\n  assert.equal(new Range('1.x').range, '1.x')\n  assert.throws(() => new Range('not a range'), TypeError)\n})","lineStart":1,"lineEnd":45,"totalLines":45,"truncated":false}},"title":"test/range.test.js","time":{"start":1787390933247,"end":1787390933271}},"id":"prt_028cd35b4001ZAmutwBM1EVXlI","sessionID":"ses_fd733bb11ffeahZWogHTTknbVo","messageID":"msg_028cd2711001Q1lc2at9IQKdZ5"}}
