ull) {\n    return null\n  }\n\n  const major = match[2]\n  const minor = match[3] || '0'\n  const patch = match[4] || '0'\n  const prerelease = options.includePrerelease && match[5] ? `-${match[5]}` : ''\n  const build = options.includePrerelease && match[6] ? `+${match[6]}` : ''\n\n  return parse(`${major}.${minor}.${patch}${prerelease}${build}`, options)\n}\nmodule.exports = coerce\n","metadata":{"truncated":false},"title":"https://raw.githubusercontent.com/npm/node-semver/v7.8.5/functions/coerce.js (text/plain; charset=utf-8)","time":{"start":1787390927697,"end":1787390928150}},"id":"prt_028cd2210001APB5yvJWIpmLZl","sessionID":"ses_fd7340c89ffeA4Uq5IAZspORgD","messageID":"msg_028cd0e2c001MxTQjopiZnDCrY"}}
