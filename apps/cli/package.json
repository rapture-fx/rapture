{
  "name": "@rapture/cli",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "bin": {
    "rapture": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rapture/core": "workspace:*",
    "@rapture/kernel": "workspace:*",
    "commander": "^14.0.0",
    "zod": "^4.4.3"
  }
}
