{
  "name": "@rapture/cli",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "rapture": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@rapture/core": "workspace:*",
    "@rapture/profiler": "workspace:*",
    "@rapture/change": "workspace:*",
    "@rapture/production-change": "workspace:*"
  }
}
