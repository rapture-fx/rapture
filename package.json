{
  "name": "rapture",
  "version": "0.1.0",
  "private": true,
  "description": "Disposable product worlds for stateful business-outcome testing",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm --filter @rapture/kernel test && pnpm --filter @rapture/core test && pnpm --filter @rapture/cli test",
    "typecheck": "pnpm -r typecheck",
    "rapture": "pnpm --filter @rapture/cli start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
