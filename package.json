{
  "name": "rapture",
  "version": "0.1.0",
  "private": true,
  "description": "Performance engineering for autonomous software factories",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm --filter @rapture/core test && node --test scripts/real-scale-2/ci.test.mjs && node --test scripts/guards/check-immutable-evidence.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "rapture": "pnpm --filter @rapture/cli start",
    "guard:evidence": "node scripts/guards/check-immutable-evidence.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
